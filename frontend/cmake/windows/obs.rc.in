IDI_ICON1 ICON DISCARDABLE "cmake/windows/spazzbs.ico"

1 VERSIONINFO
FILEVERSION ${OBS_VERSION_MAJOR},${OBS_VERSION_MINOR},${OBS_VERSION_PATCH},0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "SPAZZbs"
      VALUE "FileDescription", "SPAZZbs"
      VALUE "FileVersion", "${OBS_VERSION_CANONICAL}"
      VALUE "InternalName", "SPAZZbs"
      VALUE "OriginalFilename", "SPAZZbs"
      VALUE "ProductName", "SPAZZbs"
      VALUE "ProductVersion", "${OBS_VERSION_CANONICAL}"
      VALUE "Comments", "SPAZZbs, a fork of OBS Studio. Free and open source software (GPLv2)."
      VALUE "LegalCopyright", "${OBS_LEGAL_COPYRIGHT}"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
