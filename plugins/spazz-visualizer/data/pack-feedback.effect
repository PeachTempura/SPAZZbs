// GENERATED by tools/gen-packs.js from packs/common.fxh + packs/feedback.fx.
// Do not edit: edit those and run  node tools/gen-packs.js

// SPAZZbs Visualizer packs: the header every pack effect starts with.
// tools/gen-packs.js puts this in front of packs/<name>.fx to make
// data/pack-<name>.effect. Keep it in step with spazz-visualizer.effect:
// these uniforms are set by spazz-visualizer.c for every effect it loads.
//
// "bands" is a 64x1 texture written every frame:
//   r = smoothed level of the band (0..1), low -> high frequency
//   g = falling peak marker
//   b = onset flash (spikes when that band suddenly gets louder)

/* real branches on D3D; nothing on OpenGL */
#ifdef _D3D11
#define BRANCH [branch]
#else
#define BRANCH
#endif

uniform float4x4 ViewProj;
uniform texture2d bands;

uniform float2 res;
uniform float time;
uniform float flow;
uniform float bass;
uniform float mid;
uniform float treble;
uniform float level;
uniform float beat;
uniform float hue;
uniform float density;
uniform float bg;        /* how much backdrop: 0 transparent .. 1 solid */

/* the look controls, the same for every style */
uniform float3 pal_a;    /* colour palette (pal_mix 0 = the prism rainbow) */
uniform float3 pal_b;
uniform float3 pal_c;
uniform float pal_mix;
uniform float4 grade;    /* x brightness, y saturation, z fade (crossfades), w unused */
uniform float3 bg_col;   /* flat backdrop colour ... */
uniform float bg_flat;   /* ... instead of the midnight gradient */
uniform float4 view;     /* x zoom, y mirror left-right, z mirror top-bottom, w flip upside down */
uniform float flip_x;
uniform float4 cmotion;  /* x colour motion, y its 0..1 clock, z aurora look (1 classic), w beat colour step */
uniform float4 calm_in;  /* the slow music for the calm styles: x level, y bass, z treble, w a gentle swell */
uniform float4 react_mix;    /* how much each reaction follows the music: x movement/bounce, y brightness/glow, z colour, w beat pulses (0 = none, 1 = normal, 2 = double) */

/* feedback styles (MilkDrop-like): last frame, and
 * prev_on: x 1 when prev holds last frame (0 on the first frame / after a
 * reset), y seconds since last frame, z width, w height in pixels.
 * Other styles may ignore both; the plugin sets them on every draw. */
uniform texture2d prev;
uniform float4 prev_on;

sampler_state band_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

sampler_state prev_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

/* ------------------------------------------------------------------ */
/* helpers (copies of spazz-visualizer.effect's)                      */

/* ------------------------------------------------------------------ */
/* helpers                                                             */
float hash21(float2 p)
{
	float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return frac((p3.x + p3.y) * p3.z);
}

float hash11(float p)
{
	p = frac(p * 0.1031);
	p *= p + 33.33;
	p *= p + p;
	return frac(p);
}

/* Soft jewel-toned rainbow, or the chosen palette's three colours in a loop */
float3 prism(float h)
{
	float3 c = 0.5 + 0.5 * cos(6.2831853 * (h + float3(0.0, 0.333, 0.667)));
	c = c * c * (3.0 - 2.0 * c);
	float3 rainbow = lerp(c, float3(1.0, 1.0, 1.0), 0.12);

	float t = frac(h) * 3.0;
	float3 w = smoothstep(0.0, 1.0, saturate(float3(t, t - 1.0, t - 2.0)));
	float3 pc = lerp(lerp(lerp(pal_a, pal_b, w.x), pal_c, w.y), pal_a, w.z);
	return lerp(rainbow, pc, pal_mix);
}

/* zoom, mirror and flip, applied to every style's coordinates */
float2 view_uv(float2 uv)
{
	uv = (uv - 0.5) / max(view.x, 0.1) + 0.5;
	uv.x = lerp(uv.x, 1.0 - uv.x, flip_x);
	uv.y = lerp(uv.y, 1.0 - uv.y, view.w);
	uv.x = lerp(uv.x, 0.5 - abs(uv.x - 0.5), view.y);
	uv.y = lerp(uv.y, 0.5 - abs(uv.y - 0.5), view.z);
	return uv;
}

/* brightness and saturation */
float3 graded(float3 c)
{
	float l = dot(c, float3(0.299, 0.587, 0.114));
	return max(lerp(float3(l, l, l), c, grade.y), float3(0.0, 0.0, 0.0)) * grade.x;
}

float4 band_full(float x)
{
	return bands.SampleLevel(band_sampler, float2(saturate(x) * 0.984375 + 0.0078125, 0.5), 0.0);
}

float band_level(float x)
{
	return band_full(x).r;
}

float3 midnight(float2 uv)
{
	float3 top = float3(0.016, 0.014, 0.034);
	float3 bot = float3(0.030, 0.020, 0.052);
	float3 c = lerp(top, bot, uv.y);
	float2 d = uv - 0.5;
	return lerp(c * (1.0 - 0.9 * dot(d, d)), bg_col, bg_flat);
}

/* Tone-map accumulated light and output either transparent or over the
 * midnight backdrop. */
float4 finish(float3 light, float2 uv)
{
	float3 col = 1.0 - exp(-graded(max(light, float3(0.0, 0.0, 0.0))));
	float a = saturate(max(col.r, max(col.g, col.b)) * 1.15);
	/* light over the backdrop, which is bg see-through */
	float out_a = saturate(a + bg * (1.0 - a));
	float3 out_c = (col + midnight(uv) * bg) / max(out_a, 0.0001);
	return float4(min(out_c, float3(1.0, 1.0, 1.0)), out_a * grade.z);
}

/* mod that matches on D3D and OpenGL for negative numbers too */
float glmod(float x, float y)
{
	return x - y * floor(x / y);
}

float2 rot2(float2 v, float a)
{
	float c = cos(a);
	float s = sin(a);
	return float2(c * v.x - s * v.y, s * v.x + c * v.y);
}

/* solid (painted) styles: straight colour + coverage, transparent or over
 * the midnight backdrop */
float4 finish_paint(float4 c, float2 uv)
{
	float3 rgb = min(graded(c.rgb), float3(1.0, 1.0, 1.0));
	float out_a = c.a + bg * (1.0 - c.a);
	float3 out_c = (rgb * c.a + midnight(uv) * bg * (1.0 - c.a)) / max(out_a, 0.0001);
	return float4(out_c, out_a * grade.z);
}

float4 over(float4 under_c, float3 col, float a)
{
	float out_a = a + under_c.a * (1.0 - a);
	float3 out_c = (col * a + under_c.rgb * under_c.a * (1.0 - a)) / max(out_a, 0.0001);
	return float4(out_c, out_a);
}

/* smooth value noise and a few octaves of it */
float vnoise(float2 p)
{
	float2 i = floor(p);
	float2 f = frac(p);
	float2 u = f * f * (3.0 - 2.0 * f);
	float a = hash21(i);
	float b = hash21(i + float2(1.0, 0.0));
	float c = hash21(i + float2(0.0, 1.0));
	float d = hash21(i + float2(1.0, 1.0));
	return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

float fbm4(float2 p)
{
	float s = 0.0;
	float amp = 0.5;
	for (int i = 0; i < 4; i++) {
		s += amp * vnoise(p);
		p = p * 2.03 + float2(1.7, 9.2);
		amp *= 0.5;
	}
	return s;
}

/* Colour motion: how a style's colours travel. h is the style's own hue,
 * along runs 0..1 along a ribbon or wave, layer picks a ribbon.
 * cmotion.x: 0 gradient (the style's own), 1 falling, 2 rising, 3 a colour
 * per ribbon, 4 slow drift, 5 ripple from the centre, 6 shift on the beat,
 * 7 rainbow flowing along. cmotion.y is a 0..1 clock that wraps, so only
 * whole multiples of it are used; cmotion.w is the beat's colour step. */
float cm_hue(float h, float2 uv, float along, float layer)
{
	float m = cmotion.x;
	float c = cmotion.y;
	float r = h;
	if (m > 0.5 && m < 1.5) {
		r = h + uv.y * 0.85 - c * 3.0;
	} else if (m > 1.5 && m < 2.5) {
		r = h + uv.y * 0.85 + c * 3.0;
	} else if (m > 2.5 && m < 3.5) {
		r = hue + layer * 0.27 + 0.12 * sin(6.2831853 * (c * 2.0 + layer * 0.31)) + along * 0.08;
	} else if (m > 3.5 && m < 4.5) {
		r = hue + along * 0.12 + 0.22 * sin(6.2831853 * (c + along * 0.15 + layer * 0.07));
	} else if (m > 4.5 && m < 5.5) {
		float2 d = float2((uv.x - 0.5) * res.x / res.y, uv.y - 0.5);
		r = hue + length(d) * 1.4 - c * 4.0 + layer * 0.05;
	} else if (m > 5.5 && m < 6.5) {
		r = hue + cmotion.w + along * 0.18 + layer * 0.06;
	} else if (m > 6.5) {
		r = hue + along * 1.0 - c * 4.0 + layer * 0.11;
	}
	return r;
}

/* finish() with a little dither, so slow glows don't band */
float4 finish_dither(float3 light, float2 uv, float2 pix)
{
	float4 c = finish(light, uv);
	float n = hash21(pix + frac(time * 7.0) * 61.0) - 0.5;
	c.rgb = saturate(c.rgb + n / 255.0);
	return c;
}

/* soft energy for the calm styles: the slow-moving level, swelling a
 * little with the music and never flashing */
float calm_e(float x, float k)
{
	return lerp(band_level(x), calm_in.x * 1.3, k);
}

/* ------------------------------------------------------------------ */
/* feedback helpers                                                    */

/* last frame at uv (0..1 over the source, top left 0,0), straight colour
 * and alpha; transparent on the first frame */
float4 prev_at(float2 uv)
{
	float4 c = prev.SampleLevel(prev_sampler, uv, 0.0);
	float inside = step(0.0, uv.x) * step(uv.x, 1.0) * step(0.0, uv.y) * step(uv.y, 1.0);
	return c * prev_on.x * inside;
}

/* fade per second -> fade for this frame, so decay doesn't depend on fps */
float fb_decay(float per_second)
{
	return pow(saturate(per_second), clamp(prev_on.y, 0.0, 0.1));
}

/* what a feedback pass returns: straight colour and coverage, NOT graded
 * and without backdrop. FeedbackShow grades it and adds the backdrop. */
float4 fb_out(float3 col, float a)
{
	return float4(saturate(col), saturate(a));
}

/* the plugin's second pass for feedback styles: the buffer to the screen */
float4 PSFeedbackShow(VertData v_in) : TARGET
{
	float4 c = prev.SampleLevel(prev_sampler, v_in.uv, 0.0);
	float3 rgb = min(graded(c.rgb), float3(1.0, 1.0, 1.0));
	float out_a = c.a + bg * (1.0 - c.a);
	float3 out_c = (rgb * c.a + midnight(v_in.uv) * bg * (1.0 - c.a)) / max(out_a, 0.0001);
	return float4(out_c, out_a * grade.z);
}

technique FeedbackShow
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSFeedbackShow(v_in);
	}
}

/* ------------------------------------------------------------------ */
/* the pack's own styles follow                                        */

/* ================================================================== */
/* Feedback pack: MilkDrop / Geiss style, each frame warps the last     */
/* (styles listed in pack-feedback.h with VZ_FEEDBACK; see tools/PACKS.md) */
/* ================================================================== */

/* Zoom Tunnel: a ring shaped by the spectrum is drawn every frame, and
 * last frame is zoomed in and turned a little, so the rings stream into a
 * tunnel. Bass zooms harder, mids turn it. */
float4 PSMilkZoomTunnel(VertData v_in) : TARGET
{
	float aspect = res.x / res.y;
	/* frames at 60 fps this step stands for, so speed doesn't follow fps */
	float steps = clamp(prev_on.y * 60.0, 0.0, 4.0);

	/* last frame, zoomed towards the centre and turned */
	float2 c = v_in.uv - 0.5;
	c.x *= aspect;
	float z = pow(0.985 - 0.02 * saturate(bass), steps);
	c = rot2(c * z, (0.004 + 0.012 * mid) * steps);
	c.x /= aspect;
	float4 old = prev_at(c + 0.5);
	float keep = fb_decay(0.3);
	old *= keep;

	/* this frame's ring */
	float2 uv = view_uv(v_in.uv);
	float2 p = float2((uv.x - 0.5) * aspect, uv.y - 0.5);
	float r = length(p);
	float s = abs(atan2(p.y, p.x)) / 3.14159265;
	float rad = 0.12 + 0.17 * band_level(s) + 0.05 * beat;
	float w = 1.6 / res.y;
	float ring = saturate(1.0 - abs(r - rad) / (w * 2.0));
	float3 col = prism(hue + s * 0.5 + time * 0.05);

	float out_a = ring + old.a * (1.0 - ring);
	float3 rgb = (col * ring + old.rgb * old.a * (1.0 - ring)) / max(out_a, 0.0001);
	return fb_out(rgb, out_a);
}

technique MilkZoomTunnel
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSMilkZoomTunnel(v_in);
	}
}
