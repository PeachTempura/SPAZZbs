// SPAZZbs Visualizer
//
// "bands" is a 64x1 texture written every frame by spazz-visualizer.c:
//   r = smoothed level of the band (0..1), low -> high frequency
//   g = falling peak marker
//   b = onset flash (spikes when that band suddenly gets louder)
//
// Coordinates used below: p.x in [0, aspect], p.y in [0, 1] from the top,
// so shapes stay round on any canvas size. "px" is one pixel in those units.

/* real branches on D3D (skips work for far-away drops); nothing on OpenGL */
#ifdef _D3D11
#define BRANCH [branch]
#else
#define BRANCH
#endif

uniform float4x4 ViewProj;
uniform texture2d bands;

uniform float2 res;
uniform float time;
uniform float flow;
uniform float bass;
uniform float mid;
uniform float treble;
uniform float level;
uniform float beat;
uniform float hue;
uniform float density;
uniform float bg;        /* how much backdrop: 0 transparent .. 1 solid */

/* the look controls, the same for every style */
uniform float3 pal_a;    /* colour palette (pal_mix 0 = the prism rainbow) */
uniform float3 pal_b;
uniform float3 pal_c;
uniform float pal_mix;
uniform float4 grade;    /* x brightness, y saturation, z fade (crossfades), w unused */
uniform float3 bg_col;   /* flat backdrop colour ... */
uniform float bg_flat;   /* ... instead of the midnight gradient */
uniform float4 view;     /* x zoom, y mirror left-right, z mirror top-bottom, w flip upside down */
uniform float flip_x;

/* the SPAZZamp player styles */
uniform texture2d font_tex;  /* pixel font: 95 glyphs, 6 pixels apart, 8 tall (576x8) */
uniform texture2d text_tex;  /* 256x4 character codes: 0 marquee, 1 kbps, 2 kHz, 3 labels */
uniform float4 pl_state;     /* x progress 0..1, y 0 idle 1 playing 2 paused 3 stopped, z marquee scroll (chars), w marquee loop length (0 = still) */
uniform float4 pl_digits;    /* the clock, m m s s */
uniform float4 pl_info;      /* x volume, y shuffle, z repeat (0 off 1 all 2 one), w 1 = showing time left */
uniform float4 pl_look;      /* x LCD viz kind, y strip viz kind (-1 off), z colour cycle, w accent mode (0 fixed, 1 cycle, 2 palette) */
uniform float3 pl_accent;
uniform float4 pl_show;      /* x title bar, y seek bar, z buttons, w stereo */
uniform float3 pl_accent2;   /* a colour scheme's second colour */
uniform float4 pl_glitch;    /* x glitch amount, y music drive (with the amount), z glitch clock (holds on hits), w garbage letters */

sampler_state band_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

sampler_state font_sampler {
	Filter   = Point;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

/* ------------------------------------------------------------------ */
/* helpers                                                             */

float hash21(float2 p)
{
	float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return frac((p3.x + p3.y) * p3.z);
}

float hash11(float p)
{
	p = frac(p * 0.1031);
	p *= p + 33.33;
	p *= p + p;
	return frac(p);
}

/* Soft jewel-toned rainbow, or the chosen palette's three colours in a loop */
float3 prism(float h)
{
	float3 c = 0.5 + 0.5 * cos(6.2831853 * (h + float3(0.0, 0.333, 0.667)));
	c = c * c * (3.0 - 2.0 * c);
	float3 rainbow = lerp(c, float3(1.0, 1.0, 1.0), 0.12);

	float t = frac(h) * 3.0;
	float3 w = smoothstep(0.0, 1.0, saturate(float3(t, t - 1.0, t - 2.0)));
	float3 pc = lerp(lerp(lerp(pal_a, pal_b, w.x), pal_c, w.y), pal_a, w.z);
	return lerp(rainbow, pc, pal_mix);
}

/* zoom, mirror and flip, applied to every style's coordinates */
float2 view_uv(float2 uv)
{
	uv = (uv - 0.5) / max(view.x, 0.1) + 0.5;
	uv.x = lerp(uv.x, 1.0 - uv.x, flip_x);
	uv.y = lerp(uv.y, 1.0 - uv.y, view.w);
	uv.x = lerp(uv.x, 0.5 - abs(uv.x - 0.5), view.y);
	uv.y = lerp(uv.y, 0.5 - abs(uv.y - 0.5), view.z);
	return uv;
}

/* brightness and saturation */
float3 graded(float3 c)
{
	float l = dot(c, float3(0.299, 0.587, 0.114));
	return max(lerp(float3(l, l, l), c, grade.y), float3(0.0, 0.0, 0.0)) * grade.x;
}

float4 band_full(float x)
{
	return bands.SampleLevel(band_sampler, float2(saturate(x) * 0.984375 + 0.0078125, 0.5), 0.0);
}

float band_level(float x)
{
	return band_full(x).r;
}

float3 midnight(float2 uv)
{
	float3 top = float3(0.016, 0.014, 0.034);
	float3 bot = float3(0.030, 0.020, 0.052);
	float3 c = lerp(top, bot, uv.y);
	float2 d = uv - 0.5;
	return lerp(c * (1.0 - 0.9 * dot(d, d)), bg_col, bg_flat);
}

/* Tone-map accumulated light and output either transparent or over the
 * midnight backdrop. */
float4 finish(float3 light, float2 uv)
{
	float3 col = 1.0 - exp(-graded(max(light, float3(0.0, 0.0, 0.0))));
	float a = saturate(max(col.r, max(col.g, col.b)) * 1.15);
	/* light over the backdrop, which is bg see-through */
	float out_a = saturate(a + bg * (1.0 - a));
	float3 out_c = (col + midnight(uv) * bg) / max(out_a, 0.0001);
	return float4(min(out_c, float3(1.0, 1.0, 1.0)), out_a * grade.z);
}

/* ------------------------------------------------------------------ */
/* falling prism shimmer                                               */

float3 shimmer_layer(float2 p, float aspect, float px, float layer, float cols, float speed, float bright)
{
	float3 light = float3(0.0, 0.0, 0.0);
	float cw = aspect / cols;
	float ci = floor(p.x / cw);
	float keep = saturate(0.42 * density + 0.08 * layer);
	float w = (0.7 + 0.55 * layer) * px;

	/* the same for every drop at this pixel */
	float row = floor(p.y * res.y / (2.0 + layer));
	float fall = smoothstep(0.05, 1.0, p.y);
	float twinkle_base = time * 9.0;

	/* the furthest a drop can light anything at full volume. Pixels outside
	 * that skip the drop entirely: most pixels are near no drop at all. */
	float tail_reach = 6.0 * 0.29 * (0.7 + 0.25 * layer);
	float arm_max = px * (17.0 + 6.0 * layer);
	float reach_x = max(3.0 * w, 6.0 * px);
	float reach_below = 6.0 * arm_max;
	float reach_h = 7.8 * arm_max;
	float reach_h_y = 6.0 * px;

	for (int o = -1; o <= 1; o++) {
		float c = ci + float(o);

		for (int k = 0; k < 2; k++) {
			float kf = float(k);
			float seed = hash21(float2(c, layer * 17.0 + kf * 5.3));
			float seed2 = hash21(float2(c * 1.37 + 4.1, layer * 3.1 + kf * 11.7));

			float cx = (c + 0.2 + 0.6 * seed) * cw;

			/* speeds snap to 1/16 steps so "flow" can wrap at 64 with no
			 * visible jump (see viz_tick) */
			float spd = floor((0.35 + 0.65 * frac(seed2 * 7.7)) * speed * 16.0 + 0.5) / 16.0;
			float head = frac(seed * 7.13 + flow * spd * 0.25) * 1.5 - 0.25;

			float dx = p.x - cx;
			float dy = head - p.y;
			float adx = abs(dx);

			bool near_v = adx < reach_x && dy > -reach_below && dy < tail_reach;
			bool near_h = abs(dy) < reach_h_y && adx < reach_h;
			bool visible = seed2 <= keep && (near_v || near_h);

			BRANCH
			if (visible) {
				float bx = abs(cx / aspect - 0.5) * 2.0;
				float4 bd = band_full(bx);
				float e = bd.r;
				float fl = bd.b;

				/* glitter tail: a faint thread plus twinkling dots */
				float tail_len = (0.05 + 0.24 * e) * (0.7 + 0.25 * layer);
				float tail = step(0.0, dy) * exp(-max(dy, 0.0) / tail_len);
				float g = hash21(float2(c * 3.1 + kf * 7.0, row + floor(time * 12.0 + seed * 50.0)));
				float sparkle = smoothstep(0.6, 1.0, g);
				float xf = exp(-(dx * dx) / (w * w));
				float streak = tail * xf * (0.06 + 1.8 * sparkle);

				/* white light near the top, refracting into a spectrum as
				 * it falls; each tail runs through the colours */
				float3 tint = lerp(float3(1.0, 0.97, 0.93),
						   prism(hue + bx * 0.55 + layer * 0.13 + seed * 0.2 + dy * 2.5),
						   0.2 + 0.7 * fall);

				/* star glint: white core and vertical ray, the horizontal
				 * ray splits into a little rainbow like a prism */
				float d2 = dx * dx + dy * dy;
				float r = (1.3 + layer) * px;
				float core = exp(-d2 / (r * r));
				float arm_len = px * (5.0 + 12.0 * e + 6.0 * layer);
				float arm_v = exp(-abs(dy) / arm_len) * exp(-adx / (px * 0.8));
				float arm_h = exp(-adx / (arm_len * 1.3)) * exp(-abs(dy) / (px * 0.9));
				float twinkle = 0.65 + 0.35 * sin(twinkle_base + seed * 40.0);
				float shine = twinkle * (0.35 + 1.1 * e + 0.9 * fl);
				float3 split = prism(hue + seed * 0.3 + dx / arm_len * 0.18);

				float amount = bright * (0.22 + 1.35 * e);
				light += (tint * streak + float3(1.0, 0.98, 0.95) * (core * 1.6 + arm_v * 0.6) * shine +
					  split * arm_h * 0.9 * shine) *
					 amount;
			}
		}
	}

	return light;
}

float3 glitter_crown(float2 p, float aspect, float px)
{
	float cell_px = 3.0;
	float2 cell = floor(p * res.y / cell_px);
	float g = hash21(cell + floor(time * 8.0) * 0.618);
	float top = exp(-p.y / (0.035 + 0.06 * treble + 0.04 * density));
	float bx = abs((cell.x * cell_px / res.y) / aspect - 0.5) * 2.0;
	float e = band_level(bx);

	float2 f = frac(p * res.y / cell_px) - 0.5;
	float dot_shape = exp(-dot(f, f) * 8.0);

	float3 tint = lerp(float3(1.0, 0.97, 0.93), prism(hue + bx * 0.5), 0.35);
	return tint * smoothstep(0.92, 1.0, g) * dot_shape * top * (0.3 + 1.4 * treble + 1.2 * e);
}

float3 beat_flare(float2 p, float aspect)
{
	float x = p.x / aspect;
	float wave = 0.6 + 0.4 * sin(x * 9.0 + time * 0.7);
	return prism(hue + x * 0.35 + 0.1) * beat * 0.28 * wave * exp(-p.y / 0.16);
}

float4 PSPrismRain(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);

	float d = max(density, 0.25);
	float3 light = float3(0.0, 0.0, 0.0);
	light += shimmer_layer(p, aspect, px, 0.0, 70.0 * d, 0.55, 0.45);
	light += shimmer_layer(p, aspect, px, 1.0, 44.0 * d, 0.85, 0.80);
	light += shimmer_layer(p, aspect, px, 2.0, 26.0 * d, 1.20, 1.15);
	light += glitter_crown(p, aspect, px);
	light += beat_flare(p, aspect);

	return finish(light, uv);
}

/* ------------------------------------------------------------------ */
/* prism halo                                                          */

float4 PSPrismHalo(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);

	float2 q = p - float2(aspect * 0.5, 0.5);
	float r = length(q);
	/* the spectrum wraps the ring three times, mirrored, so the shape
	 * stays balanced: six soft petals that ripple with the music */
	float ang = atan2(q.x, -q.y);
	float a01 = ang / 6.2831853 + 0.5;
	float m = abs(frac(a01 * 3.0) - 0.5) * 2.0;

	float e = (band_level(m - 0.02) + band_level(m) * 2.0 + band_level(m + 0.02)) * 0.25;
	float base_r = 0.2 + 0.035 * level + 0.025 * beat;
	float ring_r = base_r + e * 0.035;

	float3 light = float3(0.0, 0.0, 0.0);

	/* thin glass ring, split into colour fringes by bass */
	float3 dr = (r - ring_r) + px * (1.0 + 3.0 * bass) * float3(-1.0, 0.0, 1.0);
	float w = px * (1.2 + 2.0 * e);
	float3 ring = exp(-(dr * dr) / (w * w));
	light += ring * lerp(float3(1.0, 0.97, 0.93), prism(hue + a01), 0.55) * (0.6 + 1.6 * e);

	/* faint inner rim */
	light += prism(hue + a01 + 0.5) * exp(-abs(r - base_r) / (px * 3.0)) * 0.18;

	/* prismatic rays leaving the ring */
	float nb = 160.0;
	float ai = floor(a01 * nb);
	float rh = hash11(ai + 3.7);
	float fx = frac(a01 * nb) - 0.5;
	float beam = exp(-(fx * fx) / 0.02);
	float out_d = max(r - ring_r, 0.0);
	float reach = 0.04 + 0.4 * e * (0.4 + 0.6 * rh) + 0.1 * beat;
	float ray = beam * step(ring_r, r) * exp(-out_d / reach) * (0.15 + 1.2 * e) * (0.5 + 0.5 * rh);
	light += prism(hue + a01 + out_d * 1.8) * ray * 0.9;

	/* soft bloom around the ring on beats */
	light += prism(hue + a01) * exp(-abs(r - ring_r) / 0.05) * beat * 0.25;

	/* far shimmer dust behind */
	light += shimmer_layer(p, aspect, px, 0.0, 70.0 * max(density, 0.25), 0.4, 0.3);

	return finish(light, uv);
}

/* ------------------------------------------------------------------ */
/* spectrum glass (Winamp tribute)                                     */

float4 PSSpectrumGlass(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;

	float x0 = 0.06;
	float x1 = 0.94;
	float nb = 32.0;
	float baseline = 0.74;
	float max_h = 0.58;

	float t = (uv.x - x0) / (x1 - x0);
	float i = clamp(floor(t * nb), 0.0, nb - 1.0);
	float fx = t * nb - i;
	float inside_x = step(0.0, t) * step(t, 1.0);

	float4 bd = band_full((i + 0.5) / nb);
	float h = bd.r * max_h;
	float peak_y = baseline - bd.g * max_h;

	float gap = 0.16;
	float col_mask = smoothstep(gap * 0.5, gap * 0.5 + 0.04, fx) * smoothstep(gap * 0.5, gap * 0.5 + 0.04, 1.0 - fx);
	col_mask *= inside_x;

	float3 c = prism(hue + i / nb * 0.6);
	float3 light = float3(0.0, 0.0, 0.0);

	/* the bar, with LED segments and a hot top */
	float above = baseline - uv.y;
	float in_bar = step(0.0, above) * step(above, h);
	float seg = smoothstep(0.15, 0.35, frac(above / 0.0125));
	float heat = saturate(above / max(h, 0.001));
	float3 bar_col = lerp(c * 0.8, lerp(c, float3(1.0, 1.0, 1.0), 0.4), heat) * 1.3;
	light += bar_col * in_bar * col_mask * seg * (0.9 + 0.8 * bd.b);

	/* glass sheen down the left edge of each bar */
	light += float3(1.0, 1.0, 1.0) * in_bar * col_mask * exp(-fx / 0.12) * 0.12;

	/* glowing peak cap */
	float pd = (uv.y - peak_y) / (px * 1.6);
	light += lerp(c, float3(1.0, 1.0, 1.0), 0.5) * exp(-pd * pd) * col_mask * 1.4 * step(0.01, bd.g);

	/* bloom around the bar */
	float dist_top = max(above - h, 0.0);
	float in_col = step(0.0, above + 0.002);
	light += c * col_mask * in_col * exp(-dist_top / (px * 14.0)) * bd.r * 0.25 * (1.0 - in_bar);

	/* reflection on the floor */
	float below = uv.y - baseline;
	float in_refl = step(0.0, below) * step(below, h * 0.45);
	light += bar_col * in_refl * col_mask * exp(-below / 0.05) * 0.22;

	/* floor line */
	light += prism(hue + uv.x * 0.5) * exp(-abs(below) / (px * 1.2)) * 0.35 * inside_x;

	return finish(light, uv);
}

/* ------------------------------------------------------------------ */
/* shared bits for the newer styles                                    */

/* mod that matches on D3D and OpenGL for negative numbers too */
float glmod(float x, float y)
{
	return x - y * floor(x / y);
}

float2 rot2(float2 v, float a)
{
	float c = cos(a);
	float s = sin(a);
	return float2(c * v.x - s * v.y, s * v.x + c * v.y);
}

/* solid (painted) styles: straight colour + coverage, transparent or over
 * the midnight backdrop */
float4 finish_paint(float4 c, float2 uv)
{
	float3 rgb = min(graded(c.rgb), float3(1.0, 1.0, 1.0));
	float out_a = c.a + bg * (1.0 - c.a);
	float3 out_c = (rgb * c.a + midnight(uv) * bg * (1.0 - c.a)) / max(out_a, 0.0001);
	return float4(out_c, out_a * grade.z);
}

float4 over(float4 under_c, float3 col, float a)
{
	float out_a = a + under_c.a * (1.0 - a);
	float3 out_c = (col * a + under_c.rgb * under_c.a * (1.0 - a)) / max(out_a, 0.0001);
	return float4(out_c, out_a);
}

/* ------------------------------------------------------------------ */
/* prism petals: a kaleidoscope flower, each petal one band            */

float4 PSPrismPetals(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 q = float2(uv.x * aspect, uv.y) - float2(aspect * 0.5, 0.5);
	float r = length(q);
	float3 light = float3(0.0, 0.0, 0.0);

	for (int layer = 0; layer < 2; layer++) {
		float lf = float(layer);
		float petals = 8.0 + 4.0 * lf;
		float spin = time * (0.07 - 0.16 * lf) + flow * 0.03125; /* flow wraps at 64: keep the turn whole */
		float a01 = atan2(q.y, q.x) / 6.2831853 + 0.5 + spin;
		float pi = floor(a01 * petals);
		float m = abs(frac(a01 * petals) - 0.5) * 2.0;
		float bx = abs(frac((pi + 0.5) / petals) - 0.5) * 2.0;
		bx = lf > 0.5 ? 0.5 + bx * 0.5 : bx * 0.6;
		float4 bd = band_full(bx);
		float e = bd.r;

		float len = (0.14 + 0.3 * e + 0.035 * beat) * (1.0 - 0.38 * lf);
		float rb = len * sqrt(saturate(1.0 - m * m * 0.92));
		float inside = 1.0 - smoothstep(rb - px, rb + px, r);
		float edge = exp(-abs(r - rb) / (px * (1.2 + 1.5 * e)));

		float3 tint = prism(hue + pi / petals + r * 1.8 + lf * 0.3);
		float3 glass = lerp(float3(1.0, 0.97, 0.94), tint, 0.65);
		light += glass * edge * (0.5 + 1.6 * e + bd.b) * (1.0 - 0.3 * lf);
		light += tint * inside * (0.06 + 0.35 * e) * smoothstep(0.0, len, r) * (1.0 - 0.4 * lf);

		/* a glint where each petal tips out */
		float2 tip = float2(cos((pi + 0.5) / petals * 6.2831853 - (spin + 0.5) * 6.2831853),
				    sin((pi + 0.5) / petals * 6.2831853 - (spin + 0.5) * 6.2831853)) *
			     len;
		float dt = length(q - tip);
		light += float3(1.0, 0.98, 0.95) * exp(-dt / (px * (2.0 + 4.0 * bd.b))) * (0.3 + bd.b * 1.5);
	}

	/* the jewel in the middle */
	light += lerp(float3(1.0, 1.0, 1.0), prism(hue + time * 0.05), 0.3) * exp(-r / (0.012 + 0.02 * bass)) * (0.8 + beat);
	light += prism(hue + r * 3.0) * exp(-r / 0.25) * beat * 0.15;
	return finish(light, uv);
}

/* ------------------------------------------------------------------ */
/* prism aurora: rainbow curtains that rise with the music              */

float4 PSPrismAurora(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float x = uv.x;
	float3 light = float3(0.0, 0.0, 0.0);

	for (int layer = 0; layer < 3; layer++) {
		float lf = float(layer);
		float e = band_level(abs(frac(x * (0.8 + 0.3 * lf) + lf * 0.21) - 0.5) * 2.0);
		float y0 = 0.16 + 0.12 * lf + 0.05 * sin(x * 5.0 + time * 0.25 + lf * 1.7) +
			   0.03 * sin(x * 13.0 - time * 0.4 + lf);
		float height = 0.08 + 0.42 * e + 0.05 * beat;
		float below = uv.y - y0;
		float fold = sin(x * (38.0 + 9.0 * lf) + time * (0.9 + 0.3 * lf) + 2.0 * sin(x * 6.0 + time * 0.5 + lf));
		float curtain = smoothstep(-0.006, 0.01, below) * exp(-max(below, 0.0) / height);
		float rays = 0.35 + 0.65 * fold * fold;
		float3 tint = prism(hue + x * 0.45 + below * 1.6 + lf * 0.18);
		light += tint * curtain * rays * (0.18 + 0.9 * e) * (1.0 - 0.25 * lf);
		/* a bright hem along the top edge */
		light += lerp(tint, float3(1.0, 1.0, 1.0), 0.4) * exp(-abs(below) / (px * 2.5)) * (0.1 + 0.6 * e);
	}

	/* stars behind it */
	float2 cell = floor(uv * res / 3.0);
	float st = hash21(cell);
	float tw = 0.5 + 0.5 * sin(time * 3.0 + st * 60.0);
	light += float3(0.9, 0.92, 1.0) * smoothstep(0.996, 1.0, st) * tw * 0.8 * (0.5 + treble);
	return finish(light, uv);
}

/* ------------------------------------------------------------------ */
/* prism tunnel: hexagon rings rushing at you                          */

float4 PSPrismTunnel(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float2 q = float2(uv.x * aspect, uv.y) - float2(aspect * 0.5, 0.5);
	q = rot2(q, time * 0.05 + bass * 0.08);
	float hexd = max(abs(q.x) * 0.866 + abs(q.y) * 0.5, abs(q.y));
	float ang = atan2(q.y, q.x) / 6.2831853 + 0.5;

	float depth = 0.14 / max(hexd, 0.002);
	float travel = depth + flow * 0.5;
	float f = frac(travel * 3.0);
	float id = glmod(floor(travel * 3.0), 32.0);
	float4 bd = band_full(hash11(id + 0.5));
	float e = bd.r;

	float ring = exp(-min(f, 1.0 - f) / (0.025 + 0.04 * e));
	/* rings thin out as they reach you instead of flooding the screen */
	float fade = smoothstep(0.0, 0.08, hexd) * exp(-depth * 0.08) * (1.0 - 0.75 * smoothstep(0.3, 0.75, hexd));
	float3 tint = prism(hue + id * 0.09 + ang * 0.5);
	float3 light = lerp(tint, float3(1.0, 1.0, 1.0), 0.25 * bd.b) * ring * fade * (0.25 + 1.6 * e + bd.b);

	/* light spokes down the corners */
	float spoke = exp(-abs(frac(ang * 6.0) - 0.5) * 60.0);
	light += prism(hue + ang + depth * 0.1) * spoke * fade * (0.08 + 0.4 * mid);
	/* the far end glows on beats */
	light += prism(hue + time * 0.1) * exp(-hexd / 0.05) * (0.15 + 0.8 * beat);
	return finish(light, uv);
}

/* ------------------------------------------------------------------ */
/* prism waves: ribbons of light, one per band group                   */

float4 PSPrismWaves(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float x = uv.x * aspect;
	float3 light = float3(0.0, 0.0, 0.0);

	for (int i = 0; i < 7; i++) {
		float fi = float(i);
		float4 bd = band_full((fi + 0.5) / 7.0);
		float e = bd.r;
		float yc = 0.5 + (fi - 3.0) * 0.045;
		float env = sin(uv.x * 3.14159);
		float amp = (0.015 + 0.16 * e) * env;
		/* flow wraps at 64, so its speeds are whole turns per wrap */
		float wy = yc + amp * sin(x * (3.0 + fi * 0.9) + flow * 0.0981748 * (8.0 + fi) + fi * 1.3) +
			   amp * 0.4 * sin(x * (7.0 + fi) - time * 0.7);
		float w = px * (1.0 + 2.5 * e + 2.0 * bd.b);
		float d = abs(uv.y - wy);
		float3 tint = prism(hue + fi / 7.0 + uv.x * 0.25);
		light += lerp(tint, float3(1.0, 1.0, 1.0), 0.3) * exp(-d / w) * (0.35 + 1.4 * e);
		light += tint * exp(-d / (w * 10.0)) * 0.12 * e;
	}
	return finish(light, uv);
}

/* ------------------------------------------------------------------ */
/* bubbles: soap bubbles drifting up, bigger when it's louder           */

float4 PSBubbles(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);
	float cols = floor(10.0 * max(density, 0.3));
	float cw = aspect / cols;
	float ci = floor(p.x / cw);
	float3 light = float3(0.0, 0.0, 0.0);

	for (int o = -1; o <= 1; o++) {
		for (int k = 0; k < 2; k++) {
			float c = ci + float(o);
			float kf = float(k);
			float seed = hash21(float2(c, kf * 7.1 + 3.0));
			float seed2 = hash21(float2(c * 2.3 + 1.7, kf * 3.9));
			float bx = saturate((c + 0.5) * cw / aspect);
			float4 bd = band_full(abs(bx - 0.5) * 2.0);
			float e = bd.r;
			float spd = floor((0.25 + 0.35 * seed2) * 16.0 + 0.5) / 16.0;
			float rise = frac(seed * 5.3 + flow * spd * 0.25);
			float cy = 1.15 - rise * 1.35;
			float cx = (c + 0.5 + 0.3 * sin(time * (0.6 + seed) + seed * 20.0)) * cw;
			float R = (0.02 + 0.035 * seed2) * (0.7 + 0.9 * e);
			float2 d2 = p - float2(cx, cy);
			float d = length(d2);
			BRANCH
			if (d < R * 1.6) {
				float ang = atan2(d2.y, d2.x);
				float rim = exp(-abs(d - R) / (px * (1.1 + e)));
				float3 film = prism(hue + seed + ang * 0.12 + (R - d) * 30.0 + time * 0.1);
				light += film * rim * (0.6 + 1.2 * e + bd.b);
				light += film * step(d, R) * 0.04;
				float hl = length(d2 - float2(-0.35, -0.4) * R);
				light += float3(1.0, 1.0, 1.0) * exp(-hl / (R * 0.12)) * 0.9;
			}
		}
	}
	return finish(light, uv);
}

/* ------------------------------------------------------------------ */
/* confetti: bursts of tumbling paper, more on every beat               */

float4 PSConfetti(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float2 p = float2(uv.x * aspect, uv.y);
	float cols = floor(26.0 * max(density, 0.3));
	float cw = aspect / cols;
	float ci = floor(p.x / cw);
	float4 col = float4(0.0, 0.0, 0.0, 0.0);

	for (int o = -1; o <= 1; o++) {
		for (int k = 0; k < 3; k++) {
			float c = ci + float(o);
			float kf = float(k);
			float seed = hash21(float2(c, kf * 5.7 + 1.0));
			float seed2 = hash21(float2(c * 1.9 + 3.3, kf * 2.1 + 9.0));
			float bx = saturate((c + 0.5) * cw / aspect);
			float e = band_level(abs(bx - 0.5) * 2.0);
			/* quieter parts of the song thin the confetti out */
			float shown = step(seed2, 0.25 + 0.75 * saturate(e * 1.6 + beat * 0.4));
			float spd = floor((0.3 + 0.4 * seed2) * 16.0 + 0.5) / 16.0;
			float fall = frac(seed * 9.1 + flow * spd * 0.25);
			float cy = fall * 1.2 - 0.1;
			float cx = (c + 0.5 + 0.35 * sin(time * (1.5 + seed * 2.0) + seed * 30.0)) * cw;
			float2 d2 = p - float2(cx, cy);
			BRANCH
			if (shown > 0.5 && abs(d2.x) < 0.04 && abs(d2.y) < 0.04) {
				float spin = time * (2.0 + 4.0 * seed) + seed * 50.0;
				float2 l = rot2(d2, spin);
				/* the twirl: the piece narrows as it turns edge-on */
				float tw = abs(cos(time * (3.0 + 3.0 * seed2) + seed * 17.0));
				float2 half_size = float2(0.014 * max(tw, 0.12), 0.007) * (0.9 + 0.5 * e);
				float2 q2 = abs(l) - half_size;
				float sd = length(max(q2, float2(0.0, 0.0))) + min(max(q2.x, q2.y), 0.0);
				float a = 1.0 - smoothstep(0.0, 1.0 / res.y, sd);
				float3 paper = prism(seed * 3.0 + hue);
				paper = paper * paper * (0.75 + 0.35 * tw);
				col = over(col, paper, a);
			}
		}
	}
	return finish_paint(col, uv);
}

/* ------------------------------------------------------------------ */
/* bounce buddies: little blobs that hop to their band                  */

float4 PSBounceBuddies(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);
	float4 col = float4(0.0, 0.0, 0.0, 0.0);
	float floor_y = 0.86;
	float n = 8.0;

	for (int i = 0; i < 8; i++) {
		float fi = float(i);
		float4 bd = band_full((fi + 0.5) / n);
		float e = bd.r;
		float R = min(0.075, aspect / n * 0.32);
		float cx = (fi + 0.5) / n * aspect;
		float hop = e * 0.32 + bd.b * 0.05;
		/* stretched going up, squashed when landing */
		float sy = 1.0 + 0.25 * e - 0.15 * (1.0 - smoothstep(0.0, 0.03, hop));
		float sx = 1.0 / sy;
		float cy = floor_y - hop - R * sy;
		float2 d = (p - float2(cx, cy)) / float2(R * sx, R * sy);

		/* shadow on the floor, smaller the higher it hops */
		float2 sh = (p - float2(cx, floor_y + 0.008)) / float2(R * (1.1 - hop), R * 0.18);
		col = over(col, float3(0.0, 0.0, 0.0), 0.35 * (1.0 - smoothstep(0.8, 1.0, length(sh))));

		float body_d = length(d);
		BRANCH
		if (body_d < 1.3) {
			float a = 1.0 - smoothstep(1.0 - 2.0 * px / R, 1.0, body_d);
			float3 skin = prism(hue + fi / n);
			float shade = 0.75 + 0.35 * saturate(-d.y * 0.6 + 0.4) - 0.2 * saturate(d.y);
			float3 c = skin * shade;
			/* outline */
			float rim = smoothstep(0.86, 0.94, body_d);
			c = lerp(c, skin * 0.35, rim);
			col = over(col, c, a);

			/* eyes, looking around; they blink now and then */
			float look = sin(time * 0.7 + fi * 1.9) * 0.08;
			float blink_t = frac(time * 0.23 + hash11(fi * 3.3));
			float blink = smoothstep(0.0, 0.015, abs(blink_t - 0.5) - 0.006);
			for (int s = 0; s < 2; s++) {
				float side = float(s) * 2.0 - 1.0;
				float2 ed = (d - float2(side * 0.32, -0.18)) / float2(0.22, 0.26 * max(blink, 0.08));
				float eye = 1.0 - smoothstep(0.9, 1.0, length(ed));
				col = over(col, float3(1.0, 1.0, 1.0), eye * a);
				float2 pd = d - float2(side * 0.32 + look, -0.16 + 0.04 * e);
				float pupil = 1.0 - smoothstep(0.085, 0.11, length(pd));
				col = over(col, float3(0.05, 0.04, 0.08), pupil * eye * a);
			}
			/* mouth: a smile, opening into an "o" when it's loud */
			float open_m = saturate(e * 1.4);
			float2 md = (d - float2(0.0, 0.3)) / float2(0.22, 0.06 + 0.16 * open_m);
			float mouth = (1.0 - smoothstep(0.85, 1.0, length(md))) * step(0.28, d.y + 0.02 * (1.0 - open_m));
			col = over(col, float3(0.25, 0.05, 0.1), mouth * a);
		}
	}
	return finish_paint(col, uv);
}

/* ------------------------------------------------------------------ */
/* disco floor: a light-up dance floor and a mirror ball               */

float4 PSDiscoFloor(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);
	float3 light = float3(0.0, 0.0, 0.0);
	float horizon = 0.5;

	/* the floor */
	float dy = uv.y - horizon;
	BRANCH
	if (dy > 0.003) {
		float z = 0.35 / dy;
		float wx = (p.x - aspect * 0.5) * z;
		float wz = z + flow * 0.8333333; /* 64 tiles per wrap of flow */
		float2 tile = floor(float2(wx, wz) * 1.2);
		float2 tf = frac(float2(wx, wz) * 1.2);
		float tid = hash21(float2(tile.x, glmod(tile.y, 64.0)));
		float e = band_level(tid);
		float tile_on = smoothstep(0.12, 0.45, e + 0.15 * sin(time * 2.0 + tid * 30.0));
		float edge = smoothstep(0.0, 0.06, min(min(tf.x, 1.0 - tf.x), min(tf.y, 1.0 - tf.y)));
		float fog = exp(-z * 0.12);
		light += prism(hue + tid) * tile_on * edge * fog * (0.8 + 1.8 * e);
		light += float3(0.4, 0.35, 0.6) * (1.0 - edge) * fog * 0.08;
	}

	/* the mirror ball */
	float2 bc = float2(aspect * 0.5, 0.2);
	float br = 0.1 + 0.01 * beat;
	float2 bq = (p - bc) / br;
	float bd2 = dot(bq, bq);
	BRANCH
	if (bd2 < 1.0) {
		float bz = sqrt(1.0 - bd2);
		float lon = atan2(bq.x, bz) + time * 0.6;
		float lat = asin(clamp(bq.y, -1.0, 1.0));
		float2 facet = floor(float2(lon * 5.0, lat * 5.0));
		float2 ff = frac(float2(lon * 5.0, lat * 5.0));
		float fh = hash21(facet + 7.0);
		float gap = smoothstep(0.0, 0.12, min(min(ff.x, 1.0 - ff.x), min(ff.y, 1.0 - ff.y)));
		float glint = pow(saturate(fh), 12.0) * (0.5 + 2.0 * treble + beat);
		float3 base = float3(0.55, 0.55, 0.62) * (0.35 + 0.65 * bz);
		light += (base + prism(hue + fh) * glint) * gap;
	}
	light += float3(1.0, 1.0, 1.0) * exp(-abs(sqrt(bd2) - 1.0) * br / (px * 2.0)) * 0.2;

	/* light spots swinging around the room */
	for (int i = 0; i < 5; i++) {
		float fi = float(i);
		float2 sp = float2(aspect * (0.5 + 0.42 * sin(time * (0.3 + fi * 0.07) + fi * 2.1)),
				   0.15 + 0.3 * frac(fi * 0.37 + time * 0.03));
		float e = band_level(fi / 5.0 + 0.1);
		light += prism(hue + fi * 0.2) * exp(-length(p - sp) / (0.012 + 0.03 * e)) * (0.2 + 1.2 * e) *
			 step(uv.y, horizon);
	}
	return finish(light, uv);
}

/* ------------------------------------------------------------------ */
/* lava lamp: wax that warms at the bottom, rises, cools and sinks.    */
/* The music is the heat: louder makes the wax swell, glow and move.   */

/* the glass's half width at height y (lamp units: 0 top .. 1 bottom) */
float lamp_glass_w(float y)
{
	float t = saturate((y - 0.13) / 0.66);
	return lerp(0.072, 0.178, smoothstep(0.0, 0.82, t)) - 0.018 * smoothstep(0.86, 1.0, t);
}

float4 PSLavaLamp(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);

	/* one big lamp; turn Amount up for a row of them */
	float lamps = 2.0 * floor(max((aspect * density - 0.5) * 0.75, 0.0)) + 1.0;
	float cw = aspect / lamps;
	float li = clamp(floor(p.x / cw), 0.0, lamps - 1.0);
	float H = min(0.94, cw * 1.9);
	float2 l = float2(p.x - (li + 0.5) * cw, p.y - (1.0 - H) * 0.5) / H;
	float pw = px / H; /* one pixel in lamp units */
	float seed = hash11(li * 7.77 + 1.3);

	float3 wax = prism(hue + li * 0.29 + 0.02);
	float3 liquid = lerp(prism(hue + li * 0.29 + 0.78), float3(0.08, 0.06, 0.16), 0.35);
	float heat_glow = 0.55 + 0.6 * level + 0.35 * bass + 0.25 * beat;

	float4 col = float4(0.0, 0.0, 0.0, 0.0);

	/* soft light around the glass */
	float gw = lamp_glass_w(l.y);
	float in_band = smoothstep(0.05, 0.16, l.y) * (1.0 - smoothstep(0.8, 0.9, l.y));
	float out_d = max(abs(l.x) - gw, 0.0);
	col = over(col, wax, saturate(exp(-out_d / (0.05 + 0.04 * level)) * in_band * 0.32 * heat_glow) * step(0.0001, out_d));

	/* ---- the glass: liquid, wax, highlights ---- */
	float de = gw - abs(l.x); /* distance inside the glass edge */
	float glass_a = smoothstep(-pw, pw, de) * smoothstep(0.13 - pw, 0.13 + pw, l.y) * (1.0 - smoothstep(0.79 - pw, 0.79 + pw, l.y));
	BRANCH
	if (glass_a > 0.0) {
		float field = 0.0;
		float hot = 0.0;
		for (int i = 0; i < 7; i++) {
			float fi = float(i);
			float s1 = hash11(fi * 3.71 + li * 13.1 + 0.5);
			float s2 = hash11(fi * 9.13 + li * 5.3 + 2.0);
			/* whole turns per 64 of flow, so the flow wrap is seamless */
			float turns = 3.0 + floor(s1 * 4.0);
			float ph = 6.2831853 * (turns * flow / 64.0 + s2);
			float rise = 0.5 - 0.5 * cos(ph);
			rise = rise * rise * (3.0 - 2.0 * rise); /* lingers at the top and bottom */
			float by = 0.76 - rise * 0.56;
			float bx = lamp_glass_w(by) * 0.5 * sin(time * (0.11 + 0.07 * s1) + s2 * 40.0);
			float e = band_level((fi + 0.5) / 7.0);
			float r = (0.028 + 0.022 * s1) * (0.85 + 0.5 * e + 0.12 * beat);
			/* stretched while it moves, round when it rests */
			float stretch = 1.0 + 0.55 * abs(sin(ph)) * (1.0 - abs(rise - 0.5));
			float2 d = (l - float2(bx, by)) * float2(sqrt(stretch), 1.0 / stretch);
			float k = r * r / max(dot(d, d), 0.000001);
			field += k;
			hot += k * e;
		}
		/* the pool of warm wax on the bottom, and a little stuck at the top */
		float2 pool = float2(l.x / (lamp_glass_w(0.8) * 1.05), (l.y - 0.815) / (0.028 + 0.02 * bass + 0.008 * beat));
		field += 1.0 / max(dot(pool, pool), 0.0001);
		float2 cap = float2(l.x / 0.035, (l.y - 0.126) / 0.012);
		field += 0.6 / max(dot(cap, cap), 0.0001);

		float heat = saturate((l.y - 0.13) / 0.66);
		/* the liquid, lit from the bulb below */
		float3 liq = liquid * (0.35 + 0.55 * heat * heat) * heat_glow + wax * 0.1 * heat * heat;
		col = over(col, liq, 0.82 * glass_a);

		/* the wax */
		float fw = 22.0 * pw;
		float inside = smoothstep(1.0 - fw, 1.0 + fw, field);
		float core = smoothstep(1.0, 4.0, field);
		float3 w = wax * (0.62 + 0.38 * heat + 0.35 * core) * heat_glow;
		w = lerp(w, float3(1.0, 0.95, 0.85), 0.18 * core * core + 0.12 * saturate(hot / max(field, 0.001)));
		/* a darker skin where the wax is thin */
		w *= 0.75 + 0.25 * smoothstep(1.0, 1.6, field);
		col = over(col, w, inside * glass_a);
		/* a soft glow just around each blob */
		col = over(col, wax * heat_glow, (1.0 - inside) * smoothstep(0.6, 1.0, field) * 0.22 * glass_a);

		/* the glass catches the light: a bright edge and a long reflection */
		float edge = exp(-de / (pw * 1.6)) * 0.55;
		float sx = (l.x / gw + 0.55) / 0.09;
		float streak = exp(-sx * sx) * 0.22 * smoothstep(0.15, 0.3, l.y);
		col = over(col, float3(1.0, 1.0, 1.0), saturate(edge + streak) * glass_a);
	}

	/* ---- the metal cap and base ---- */
	float cap_t = saturate((l.y - 0.035) / 0.095);
	float cap_w = lerp(0.045, 0.078, cap_t);
	float in_cap = smoothstep(cap_w + pw, cap_w - pw, abs(l.x)) * smoothstep(0.035 - pw, 0.035 + pw, l.y) *
		       (1.0 - smoothstep(0.13 - pw, 0.13 + pw, l.y));
	float base_t = saturate((l.y - 0.79) / 0.19);
	float base_w = lerp(0.16, 0.22, base_t) - 0.02 * smoothstep(0.85, 1.0, base_t);
	float in_base = smoothstep(base_w + pw, base_w - pw, abs(l.x)) * smoothstep(0.79 - pw, 0.79 + pw, l.y) *
			(1.0 - smoothstep(0.98 - pw, 0.98 + pw, l.y));
	float mw = lerp(cap_w, base_w, step(0.5, l.y));
	float m = l.x / mw;
	float m1 = (m + 0.35) / 0.28;
	float m2 = (m - 0.6) / 0.2;
	float sheen = 0.22 + 0.55 * exp(-m1 * m1) + 0.18 * exp(-m2 * m2);
	float3 metal = lerp(float3(0.18, 0.18, 0.22), float3(0.85, 0.85, 0.92), sheen) * lerp(float3(1.0, 1.0, 1.0), wax, 0.2);
	/* the bulb glows through the top ring of the base */
	float ring = exp(-abs(l.y - 0.80) / 0.012) * in_base;
	metal = lerp(metal, wax * 1.3, ring * saturate(0.4 + 0.6 * heat_glow));
	/* thin lines where the metal parts meet */
	metal *= 1.0 - 0.35 * exp(-abs(l.y - 0.875) / (pw * 1.5));
	col = over(col, metal, saturate(in_cap + in_base));

	return finish_paint(col, uv);
}

/* ------------------------------------------------------------------ */
/* prism kaleidoscope: mirrored jewel shards, each lit by its band     */

float4 PSPrismKaleido(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 q = float2(uv.x * aspect, uv.y) - float2(aspect * 0.5, 0.5);
	float r = length(q);

	float segs = 2.0 * floor(3.0 + 2.0 * max(density, 0.3));
	float sector = 6.2831853 / segs;
	float a = atan2(q.y, q.x) + time * 0.04;
	a = abs(glmod(a, sector) - sector * 0.5);
	float2 k = float2(cos(a), sin(a)) * r;

	/* the glass pieces drift outward through the mirrors */
	float2 z = rot2(k, time * 0.07) * (6.0 + 1.5 * bass) - float2(flow * 0.125, 0.0);
	float2 cell = floor(z);
	float2 f = frac(z);
	/* each square splits into two triangles */
	float tri = step(f.x, f.y);
	float id = hash21(float2(glmod(cell.x, 64.0), cell.y) + tri * 17.0);
	float4 bd = band_full(id);
	float e = bd.r;
	float edge_d = min(min(f.x, 1.0 - f.x), min(min(f.y, 1.0 - f.y), abs(f.x - f.y) * 0.7071));
	float w = (6.0 + 1.5 * bass) * px * (1.2 + 2.0 * e);
	float edge = exp(-edge_d / w);

	float3 tint = prism(hue + id * 0.6 + r * 0.8);
	float fade = 1.0 - smoothstep(0.3, 0.62, r);
	float3 light = tint * (0.05 + 0.75 * e * e + 0.5 * bd.b) * fade;
	light += lerp(tint, float3(1.0, 1.0, 1.0), 0.45) * edge * (0.2 + 1.3 * e + bd.b) * fade;
	/* the mirror seams */
	float seam = exp(-a * r / (px * 1.5));
	light += prism(hue + r) * seam * fade * (0.1 + 0.5 * mid);
	/* the jewel in the middle, and a flash on beats */
	light += lerp(float3(1.0, 1.0, 1.0), prism(hue + 0.3), 0.4) * exp(-r / (0.015 + 0.03 * bass)) * (0.7 + beat);
	light += prism(hue + r * 2.0) * exp(-r / 0.2) * beat * 0.25;
	return finish(light, uv);
}

/* ------------------------------------------------------------------ */
/* star warp: flying through stars, faster and brighter when it's loud */

float4 PSStarWarp(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 q = float2(uv.x * aspect, uv.y) - float2(aspect * 0.5, 0.5);
	float r = length(q);
	float a01 = atan2(q.y, q.x) / 6.2831853 + 0.5;
	float n = floor(140.0 * max(density, 0.3));
	float ai = floor(a01 * n);
	float3 light = float3(0.0, 0.0, 0.0);

	for (int o = -1; o <= 1; o++) {
		for (int s = 0; s < 2; s++) {
			float bin = glmod(ai + float(o), n);
			float sf = float(s);
			float seed = hash21(float2(bin, sf * 7.3 + 1.0));
			float seed2 = hash21(float2(bin * 1.7 + 3.1, sf * 2.9));
			float ang = (bin + 0.2 + 0.6 * seed) / n;
			float spd = floor((0.25 + 0.5 * seed2) * 16.0 + 0.5) / 16.0;
			float zz = frac(seed * 3.7 + flow * spd * 0.25);
			/* perspective: slow far away, rushing past up close */
			float rs = 0.03 / max(1.0 - zz * 0.97, 0.03);
			float tl = rs * (0.04 + 0.35 * level + 0.25 * beat);
			float da = abs(frac(a01 - ang + 0.5) - 0.5) * 6.2831853 * r;
			float along = rs - r;
			float wid = px * (0.45 + 1.1 * zz);
			/* bright head, fading tail */
			float tail_k = saturate(along / max(tl, 0.0001));
			float inside = smoothstep(-wid * 2.0, 0.0, along) * (1.0 - smoothstep(0.7, 1.0, tail_k));
			float glow = exp(-da * da / (wid * wid)) * inside * (1.0 - 0.8 * tail_k);
			float head = exp(-length(float2(da, along)) / (wid * 1.6));
			float e = band_level(abs(ang - 0.5) * 2.0);
			float3 tint = lerp(float3(1.0, 1.0, 1.0), prism(hue + seed + zz * 0.3), 0.55);
			float closeness = smoothstep(0.08, 0.5, zz);
			light += tint * (glow + head * 0.8) * closeness * zz * (0.7 + 1.6 * e) * 1.8;
		}
	}
	/* the light at the end of the tunnel */
	light += prism(hue + time * 0.05) * exp(-r / (0.03 + 0.05 * bass)) * (0.3 + 0.9 * beat);
	return finish(light, uv);
}

/* ------------------------------------------------------------------ */
/* fireflies: little lights wandering and blinking to the music        */

float4 PSFireflies(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);
	float cs = 0.16 / sqrt(max(density, 0.3));
	float3 light = float3(0.0, 0.0, 0.0);

	for (int layer = 0; layer < 2; layer++) {
		float lf = float(layer);
		float c2 = cs * (1.0 + 0.6 * lf);
		/* they drift slowly upward: 16 cells per flow wrap, and the rows
		 * repeat every 16, so the wrap is seamless */
		float2 pp = p + float2(0.0, flow * c2 * 0.25);
		float2 ci = floor(pp / c2);
		for (int ox = -1; ox <= 1; ox++) {
			for (int oy = -1; oy <= 1; oy++) {
				float2 c = ci + float2(float(ox), float(oy));
				float2 cc = float2(c.x, glmod(c.y, 16.0));
				float seed = hash21(cc + lf * 31.0);
				float seed2 = hash21(cc * 1.3 + 7.7 + lf * 5.0);
				float2 wander = float2(sin(time * (0.3 + 0.4 * seed) + seed * 30.0), cos(time * (0.25 + 0.35 * seed2) + seed2 * 20.0));
				float2 pos = (c + 0.5 + 0.38 * wander) * c2;
				float d = length(pp - pos);
				BRANCH
				if (d < 0.08) {
					float4 bd = band_full(seed);
					float blink = smoothstep(0.2, 1.0, sin(time * (0.8 + 1.5 * seed2) + seed * 40.0));
					float glow_amt = 0.15 + blink * (0.4 + 0.6 * level) + 1.6 * bd.b + 0.8 * bd.r * treble;
					float3 tint = lerp(float3(0.85, 1.0, 0.35), prism(hue + seed * 0.4), 0.55);
					float size = (1.8 + 1.6 * (1.0 - lf)) * px;
					light += tint * (exp(-d / size) * 2.2 + exp(-d / (0.02 + 0.014 * bd.r)) * 0.32) * glow_amt *
						 (1.0 - 0.45 * lf);
				}
			}
		}
	}
	return finish(light, uv);
}

/* ------------------------------------------------------------------ */
/* synthwave: a striped retro sun over a neon grid; the mountains are  */
/* the spectrum                                                         */

float4 PSSynthwave(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);
	float horizon = 0.64;
	float4 col = float4(0.0, 0.0, 0.0, 0.0);
	float k = 0.25 + 0.75 * pal_mix;
	float3 sun_top = lerp(float3(1.0, 0.86, 0.32), prism(hue), k);
	float3 sun_bot = lerp(float3(1.0, 0.18, 0.55), prism(hue + 0.4), k);
	float3 grid_c = lerp(float3(1.0, 0.25, 0.9), prism(hue + 0.65), 0.3 + 0.7 * pal_mix);

	/* stars */
	float2 cell = floor(uv * res / 3.0);
	float st = hash21(cell);
	float tw = 0.5 + 0.5 * sin(time * 2.0 + st * 60.0);
	col = over(col, float3(1.0, 0.95, 1.0), smoothstep(0.997, 1.0, st) * tw * step(uv.y, horizon) * (0.5 + 0.5 * treble));

	/* the sun, its glow, and the stripes that slide down it */
	float2 sc = float2(aspect * 0.5, horizon - 0.2);
	float R = 0.24 * (1.0 + 0.05 * bass + 0.02 * beat);
	float sd = length(p - sc);
	col = over(col, sun_bot, saturate(exp(-max(sd - R, 0.0) / (0.05 + 0.04 * level)) * 0.45) * step(R, sd) * step(uv.y, horizon));
	float sy = (p.y - (sc.y - R)) / (2.0 * R);
	float3 sun = lerp(sun_top, sun_bot, smoothstep(0.1, 0.9, sy));
	float band_y = (p.y - sc.y) / 0.034 - flow * 0.25;
	float gap = (sy - 0.45) * 0.55;
	float stripe = step(gap, frac(band_y)) + step(sy, 0.45);
	float sun_a = (1.0 - smoothstep(R - px, R + px, sd)) * saturate(stripe);
	col = over(col, sun * (1.0 + 0.3 * beat), sun_a * step(uv.y, horizon));

	/* mountains: the spectrum, mirrored from the middle */
	float mx = abs(uv.x - 0.5) * 2.0;
	float mh = 0.03 + 0.16 * (band_level(mx * 0.9) * 0.7 + 0.3 * band_level(mx * 0.9 + 0.04)) * (0.4 + 0.6 * mx);
	float mtop = horizon - mh;
	float in_mtn = smoothstep(mtop - px, mtop + px, uv.y) * step(uv.y, horizon);
	col = over(col, float3(0.07, 0.03, 0.14) + grid_c * 0.05, in_mtn);
	col = over(col, grid_c, exp(-abs(uv.y - mtop) / (px * 1.2)) * 0.9 * step(uv.y, horizon + px));

	/* the grid floor, rushing toward you */
	float dy = uv.y - horizon;
	BRANCH
	if (dy > 0.0) {
		float z = 0.18 / max(dy, 0.0005);
		float wx = (p.x - aspect * 0.5) * z;
		float wz = z + flow * 0.5;
		float lx = abs(frac(wx * 1.5) - 0.5) / 1.5;
		float lz = abs(frac(wz * 3.0) - 0.5) / 3.0;
		float wpx = px * z;
		float e = band_level(saturate(abs(uv.x - 0.5) * 2.0));
		float line_v = exp(-lx / (wpx * 1.4));
		float line_h = exp(-lz / (wpx * 0.9));
		float fog = exp(-z * 0.18);
		float g = saturate(max(line_v, line_h) * (0.7 + 0.8 * e + 0.6 * beat)) * (0.25 + 0.75 * fog);
		col = over(col, float3(0.03, 0.01, 0.06), 0.55);
		col = over(col, lerp(grid_c, float3(1.0, 1.0, 1.0), 0.25 * g), g);
	}
	/* the horizon line */
	col = over(col, lerp(grid_c, float3(1.0, 1.0, 1.0), 0.4), exp(-abs(dy) / (px * 1.5)) * (0.7 + 0.3 * level));
	return finish_paint(col, uv);
}

/* ------------------------------------------------------------------ */
/* candy bars: glossy capsules from the middle out, with bouncing balls */

float4 PSCandyBars(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);
	float n = floor(14.0 * max(density, 0.3));
	float baseline = 0.84;
	float max_h = 0.62;
	float4 col = float4(0.0, 0.0, 0.0, 0.0);

	float side = abs(uv.x - 0.5) * 2.0;    /* 0 middle .. 1 edges */
	float t = side * n;
	float i = min(floor(t), n - 1.0);
	float fx = t - i;
	float slot = aspect * 0.5 / n;
	float wbar = slot * 0.36;
	float cx = (i + 0.5) * slot;
	float dx = abs(abs(p.x - aspect * 0.5) - cx);
	float4 bd = band_full((i + 0.5) / n);
	float h = max(bd.r * max_h, wbar * 2.0);
	float3 c = prism(hue + i / n * 0.8);

	/* the bar: a capsule standing on the floor */
	float y0 = baseline - h + wbar;
	float yy = clamp(p.y, y0, baseline - wbar);
	float d = length(float2(dx, p.y - yy)) - wbar;
	float a = 1.0 - smoothstep(-px, px, d);
	float u = dx / wbar;
	float3 body = c * (0.7 + 0.45 * (1.0 - u * u)) * (0.9 + 0.4 * bd.b);
	body = lerp(body, c * 0.45, smoothstep(-px * 2.5, 0.0, d)); /* outline */
	/* the candy shine */
	float shine = exp(-(u + 0.4) * (u + 0.4) / 0.03) * step(y0, p.y);
	body = lerp(body, float3(1.0, 1.0, 1.0), shine * 0.55);
	col = over(col, body, a);

	/* the ball that bounces on top (the falling peak) */
	float pk = baseline - max(bd.g * max_h, wbar * 2.0) - wbar * 1.25;
	float bdist = length(float2(dx, p.y - pk)) - wbar * 0.9;
	float ba = 1.0 - smoothstep(-px, px, bdist);
	float3 ball = lerp(prism(hue + i / n * 0.8 + 0.5), float3(1.0, 1.0, 1.0), 0.3);
	float2 hl = float2(dx + wbar * 0.3, p.y - pk + wbar * 0.3);
	ball = lerp(ball, float3(1.0, 1.0, 1.0), exp(-dot(hl, hl) / (wbar * wbar * 0.08)) * 0.8);
	col = over(col, ball, ba * step(0.02, bd.g));

	/* a soft reflection on the floor */
	float below = p.y - baseline;
	float refl = step(0.0, below) * exp(-below / 0.03) * step(dx, wbar) * 0.25 * step(below, h * 0.4);
	col = over(col, c, refl);
	return finish_paint(col, uv);
}

/* ------------------------------------------------------------------ */
/* groovy swirl: a hypnotic candy spiral that breathes with the bass   */

float4 PSGroovySwirl(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 q = float2(uv.x * aspect, uv.y) - float2(aspect * 0.5, 0.5);
	float r = length(q);
	float ang = atan2(q.y, q.x);
	float R = 0.36 * (1.0 + 0.08 * bass + 0.04 * beat);

	/* the edge ripples with the spectrum */
	float a01 = ang / 6.2831853 + 0.5;
	float m = abs(frac(a01 * 2.0) - 0.5) * 1.2;
	float e = (band_level(m - 0.04) + 2.0 * band_level(m) + band_level(m + 0.04)) * 0.25;
	float rim = R * (1.0 + 0.1 * e);

	float arms = 2.0 + floor(2.0 * max(density, 0.3));
	float twist = 9.0 + 4.0 * mid;
	/* whole turns per flow wrap */
	float sp = ang * arms + r * twist * 6.2831853 / 6.0 - flow * 0.7853982;
	float stripes = 0.5 + 0.5 * sin(sp);
	float ring = 0.5 + 0.5 * sin(r * 40.0 - flow * 1.5707963);
	float v = stripes * 0.75 + ring * 0.25;
	float3 c1 = prism(hue + r * 0.8);
	float3 c2 = prism(hue + 0.5 + r * 0.8);
	float3 swirl = lerp(c2, c1, smoothstep(0.35, 0.65, v));
	swirl *= 0.75 + 0.35 * level + 0.25 * beat;
	/* a little shading toward the middle and edge */
	swirl *= 0.8 + 0.2 * smoothstep(0.0, 0.12, r);
	float a = 1.0 - smoothstep(rim - px, rim + px, r);
	float4 col = float4(0.0, 0.0, 0.0, 0.0);
	/* the aura */
	col = over(col, c1, saturate(exp(-max(r - rim, 0.0) / (0.03 + 0.05 * level)) * 0.5) * step(rim, r));
	col = over(col, swirl, a);
	/* a glossy highlight */
	float2 hq = q - float2(-0.35, -0.4) * R;
	col = over(col, float3(1.0, 1.0, 1.0), exp(-dot(hq, hq) / (R * R * 0.04)) * 0.35 * a);
	return finish_paint(col, uv);
}

/* ------------------------------------------------------------------ */
/* fireworks: rockets and bursts, bigger and brighter with the music   */

float4 PSFireworks(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);
	float3 light = float3(0.0, 0.0, 0.0);
	float shells = floor(4.0 + 3.0 * max(density, 0.3));

	for (int s = 0; s < 10; s++) {
		float sf = float(s);
		BRANCH
		if (sf < shells) {
			float period = 2.6 + 1.4 * hash11(sf * 3.3);
			float tt = time + hash11(sf * 9.1) * period;
			float round_n = floor(tt / period);
			float lt = tt - round_n * period;
			float seed = hash21(float2(sf, round_n));
			float seed2 = hash21(float2(sf + 11.0, round_n * 1.3));
			float2 c = float2(aspect * (0.12 + 0.76 * seed), 0.18 + 0.3 * seed2);
			float e = band_level(seed);
			float3 tint = prism(hue + seed * 2.0 + seed2);
			float launch = 0.7;
			if (lt < launch) {
				/* the rocket going up */
				float k = lt / launch;
				float2 rp = float2(c.x + (1.0 - k) * 0.03 * (seed2 - 0.5), 1.05 - (1.05 - c.y) * (1.0 - (1.0 - k) * (1.0 - k)));
				float dxr = abs(p.x - rp.x);
				float tail = p.y - rp.y;
				light += lerp(tint, float3(1.0, 0.9, 0.7), 0.6) * exp(-dxr / (px * 1.2)) * step(0.0, tail) *
					 exp(-tail / 0.06) * 0.8;
				light += float3(1.0, 0.95, 0.85) * exp(-length(p - rp) / (px * 2.0));
			} else {
				/* the burst: sparks fly out, slow down, fall and fade */
				float bt = lt - launch;
				float size = (0.15 + 0.15 * e + 0.05 * beat) * (0.8 + 0.4 * seed2);
				float spread = size * (1.0 - exp(-bt * 3.0));
				float2 cc = c + float2(0.0, 0.06 * bt * bt);
				float2 d = p - cc;
				float r = length(d);
				float sparks = 28.0;
				float a01 = atan2(d.y, d.x) / 6.2831853 + 0.5;
				float ai = floor(a01 * sparks);
				float fade = exp(-bt * 1.3);
				for (int o = 0; o <= 1; o++) {
					float bin = glmod(ai + float(o), sparks);
					float ang = (bin + 0.5) / sparks;
					float jit = hash21(float2(bin, sf + round_n * 7.0));
					float sr = spread * (0.75 + 0.25 * jit);
					float da = abs(frac(a01 - ang + 0.5) - 0.5) * 6.2831853 * r;
					float along = sr - r;
					float trail = step(0.0, along) * exp(-along / (0.02 + 0.03 * fade));
					float twinkle = 0.6 + 0.4 * sin(time * 30.0 + jit * 50.0);
					float spark = exp(-da / (px * 1.4)) * trail * step(0.0, sr - r + px * 3.0);
					float head = exp(-length(float2(da, along)) / (px * 2.2));
					light += lerp(tint, float3(1.0, 1.0, 1.0), 0.35 * fade) * (spark * 2.2 + head * 2.5) * fade * twinkle *
						 (1.0 + 1.2 * e);
				}
				/* the flash */
				light += tint * exp(-r / (0.04 + 0.06 * e)) * exp(-bt * 6.0) * 1.2;
			}
		}
	}
	return finish(light, uv);
}

/* ------------------------------------------------------------------ */
/* spiral galaxy: arms of stars turning around a core that beats       */

float4 PSGalaxy(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 q = float2(uv.x * aspect, uv.y) - float2(aspect * 0.5, 0.5);
	/* tilted toward you */
	q = rot2(q, 0.35);
	q.y /= 0.62;
	float r = length(q);
	float ang = atan2(q.y, q.x) - time * 0.12;
	float lr = log(max(r, 0.002));

	float arms = 2.0 + floor(max(density, 0.3) * 1.5);
	float spiral = sin(ang * arms - lr * 4.5);
	float arm = pow(0.5 + 0.5 * spiral, 3.0);
	float a01 = frac(ang / 6.2831853);
	float e = band_level(saturate(r * 2.2));
	float disc = exp(-r / (0.17 + 0.05 * mid));
	float3 light = prism(hue + r * 1.5 + 0.1) * arm * disc * (0.55 + 1.8 * e);
	/* dust between the arms */
	light += prism(hue + 0.55 + r) * (1.0 - arm) * disc * 0.08;

	/* stars, thicker along the arms */
	float2 sp = float2(a01 * 220.0, lr * 18.0);
	float2 cell = floor(sp);
	float h = hash21(float2(glmod(cell.x, 220.0), cell.y));
	float2 f = frac(sp) - 0.5;
	float star = smoothstep(0.88 - 0.25 * arm, 1.0, h) * exp(-dot(f, f) * 10.0);
	float tw = 0.6 + 0.4 * sin(time * 4.0 + h * 80.0);
	light += lerp(float3(1.0, 1.0, 1.0), prism(hue + h), 0.3) * star * tw * (0.5 + 1.5 * treble) * exp(-r / 0.4);

	/* the core */
	light += lerp(float3(1.0, 0.92, 0.75), prism(hue), 0.2) * exp(-r / (0.03 + 0.03 * bass)) * (1.0 + 1.2 * beat);
	return finish(light, uv);
}

/* ------------------------------------------------------------------ */
/* rainbow ripples: raindrops on a pond, harder rain when it's loud    */

float4 PSRainbowRipples(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);
	float cs = 0.24 / sqrt(max(density, 0.3));
	float2 ci = floor(p / cs);
	float3 light = float3(0.0, 0.0, 0.0);

	/* the pond's slow shimmer */
	float sheen = sin(p.x * 13.0 + sin(p.y * 9.0 + time * 0.7) * 1.5 + time * 0.4) *
		      sin(p.y * 17.0 - time * 0.5 + sin(p.x * 7.0) * 1.2);
	light += prism(hue + 0.55 + uv.x * 0.3) * (0.03 + 0.05 * level) * (0.5 + 0.5 * sheen);

	for (int ox = -1; ox <= 1; ox++) {
		for (int oy = -1; oy <= 1; oy++) {
			float2 c = ci + float2(float(ox), float(oy));
			float seed = hash21(c);
			float seed2 = hash21(c * 1.7 + 3.1);
			float period = 1.4 + 1.8 * seed2;
			float tt = time + seed * period;
			float n = floor(tt / period);
			float lt = tt - n * period;
			float s3 = hash21(c + n * 0.37);
			float s4 = hash21(c * 2.3 + n * 1.13);
			float2 pos = (c + 0.2 + 0.6 * float2(s3, s4)) * cs;
			float d = length(p - pos);
			BRANCH
			if (d < cs * 1.3) {
				float4 bd = band_full(s3);
				/* rings spread out and slow down, never past the next cell */
				float grow = 1.0 - exp(-lt * 1.4);
				float rr = cs * 1.15 * grow;
				float fade = (1.0 - grow) * (0.15 + 1.6 * bd.r + 1.4 * bd.b + 0.5 * beat);
				float w = px * (1.0 + 4.0 * grow);
				float ring = exp(-abs(d - rr) / w) + 0.55 * exp(-abs(d - rr * 0.64) / w) +
					     0.3 * exp(-abs(d - rr * 0.36) / w);
				float splash = exp(-d / (px * 2.5)) * exp(-lt * 7.0) * 2.5;
				float3 tint = prism(hue + seed * 0.7 + d * 3.0);
				light += tint * (ring * fade + splash * (0.3 + bd.r));
			}
		}
	}
	return finish(light, uv);
}

/* ------------------------------------------------------------------ */
/* neon heartbeat: a heart monitor line, spikes with the music, and a  */
/* neon heart that thumps on the beat                                   */

float heart_dist(float2 q)
{
	/* a heart about 1 unit tall, point down, y up */
	q.x = abs(q.x);
	q.y += 0.55;
	if (q.y + q.x > 1.0) {
		float2 a = q - float2(0.25, 0.75);
		return sqrt(dot(a, a)) - 0.35355339;
	}
	float2 b = q - float2(0.0, 1.0);
	float2 m = q - 0.5 * max(q.x + q.y, 0.0);
	return sqrt(min(dot(b, b), dot(m, m))) * sign(q.x - q.y);
}

float bump(float t, float c, float w)
{
	float u = (t - c) / w;
	return exp(-u * u);
}

float ecg_shape(float t)
{
	/* one heartbeat: a little bump, the big spike, and a soft wave after */
	return 0.12 * bump(t, 0.18, 0.045) - 0.22 * bump(t, 0.37, 0.014) + bump(t, 0.41, 0.018) -
	       0.35 * bump(t, 0.45, 0.016) + 0.22 * bump(t, 0.66, 0.06);
}

float ecg_y(float x)
{
	/* 32 beats in 16 units of scroll, so the flow wrap at 64 is seamless */
	float cell = 0.5;
	float xs = x + flow * 0.25;
	float ci = floor(xs / cell);
	float t = xs / cell - ci;
	float seed = hash11(glmod(ci, 32.0) * 1.37 + 0.5);
	float e = band_level(seed * 0.6);
	float amp = 0.07 + 0.2 * e + 0.08 * beat;
	return 0.62 - amp * ecg_shape(t) - 0.004 * sin(x * 40.0 + time * 3.0) * treble;
}

float4 PSNeonHeartbeat(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);
	float3 light = float3(0.0, 0.0, 0.0);
	float3 tint = prism(hue + 0.33);

	/* faint monitor grid */
	float2 g = abs(frac(p / 0.05) - 0.5) * 0.05;
	float grid = exp(-min(g.x, g.y) / (px * 0.6));
	light += tint * grid * 0.05;

	/* the trace: brightest at the pen on the right, fading to the left */
	float head_x = aspect * 0.86;
	/* distance to the trace, from short pieces of it either side */
	float dist = 1.0;
	float step_x = px * 2.5;
	float2 prev = float2(p.x - 8.0 * step_x, ecg_y(p.x - 8.0 * step_x));
	for (int k = -7; k <= 8; k++) {
		float xk = p.x + float(k) * step_x;
		float2 cur = float2(xk, ecg_y(xk));
		float2 ab = cur - prev;
		float h = saturate(dot(p - prev, ab) / max(dot(ab, ab), 0.0000001));
		dist = min(dist, length(p - prev - ab * h));
		prev = cur;
	}
	float behind = head_x - p.x;
	float trail = step(0.0, behind) * exp(-behind / (0.45 + 0.4 * level));
	float glow = exp(-dist / (px * 1.4)) * 2.0 + exp(-dist / 0.012) * 0.35;
	light += lerp(tint, float3(1.0, 1.0, 1.0), 0.25) * glow * trail * (0.7 + 0.6 * level);

	/* the pen */
	float2 hp = float2(head_x, ecg_y(head_x));
	float hd = length(p - hp);
	light += float3(1.0, 1.0, 1.0) * exp(-hd / (px * 2.5)) * 2.0 + tint * exp(-hd / 0.03) * (0.4 + 0.8 * beat);

	/* the heart */
	float hs = 0.12 * (1.0 + 0.12 * bass + 0.18 * beat);
	float2 hq = (p - float2(aspect * 0.5, 0.27)) / hs;
	hq.y = -hq.y;
	float hdist = heart_dist(hq) * hs;
	float3 hc = prism(hue);
	light += hc * exp(-abs(hdist) / (px * 1.6)) * (1.4 + 1.5 * beat);
	light += hc * exp(-max(hdist, 0.0) / (0.02 + 0.03 * bass)) * (0.25 + 0.6 * beat);
	light += hc * step(hdist, 0.0) * (0.08 + 0.25 * beat);
	return finish(light, uv);
}

/* ------------------------------------------------------------------ */
/* flower garden: a row of flowers, each one a band, blooming as it    */
/* gets louder and swaying in the breeze                                */

float4 PSFlowerGarden(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);
	float n = floor(7.0 * max(density, 0.3));
	n = max(n, 3.0);
	float slot = aspect / n;
	float ground = 0.9;
	float4 col = float4(0.0, 0.0, 0.0, 0.0);

	float ci = floor(p.x / slot);
	for (int o = -1; o <= 1; o++) {
		float i = ci + float(o);
		BRANCH
		if (i >= 0.0 && i < n) {
			float seed = hash11(i * 3.7 + 1.0);
			float side = abs((i + 0.5) / n - 0.5) * 2.0;
			float4 bd = band_full(side * 0.85 + seed * 0.1);
			float e = bd.r;
			float bx = (i + 0.5) * slot + (seed - 0.5) * slot * 0.3;
			float h = (0.32 + 0.18 * seed) * (0.85 + 0.25 * e);
			float sway = (0.025 + 0.03 * bass) * sin(time * (0.9 + 0.3 * seed) + i * 1.7);
			float2 hc = float2(bx + sway, ground - h);

			/* the stem bends toward the head */
			float k = saturate((ground - p.y) / h);
			float sx = bx + sway * k * k;
			float stem = 1.0 - smoothstep(px * 1.5, px * 3.0, abs(p.x - sx));
			stem *= step(hc.y, p.y) * step(p.y, ground);
			float3 green = lerp(float3(0.25, 0.75, 0.3), prism(hue + 0.4), 0.25 * pal_mix);
			col = over(col, green * (0.75 + 0.25 * k), stem);

			/* one leaf */
			float2 lq = p - float2(bx + sway * 0.25 + 0.03 * (seed > 0.5 ? 1.0 : -1.0), ground - h * 0.35);
			lq = rot2(lq, seed > 0.5 ? -0.6 : 0.6);
			float leaf = length(lq / float2(0.034, 0.012)) - 1.0;
			col = over(col, green * 0.9, 1.0 - smoothstep(-0.1, 0.1, leaf));

			/* the head: petals open with the band */
			float2 q = p - hc;
			float r = length(q);
			float spin = time * (0.15 + 0.1 * seed) + seed * 6.0;
			float ang = atan2(q.y, q.x) + spin;
			float petals = 5.0 + floor(seed * 3.0);
			float bloom = 0.034 + 0.06 * e + 0.014 * bd.b + 0.008 * beat;
			float shape = 0.45 + 0.55 * abs(cos(ang * petals * 0.5));
			float pr = bloom * shape;
			float pa = 1.0 - smoothstep(pr - px, pr + px, r);
			float3 pc = prism(hue + i / n * 0.9 + seed * 0.2);
			float3 petal = lerp(pc * 0.75, lerp(pc, float3(1.0, 1.0, 1.0), 0.35), smoothstep(0.0, pr, r));
			col = over(col, petal, pa);

			/* the middle, with seeds */
			float cr = bloom * 0.38;
			float ca = 1.0 - smoothstep(cr - px, cr + px, r);
			float dots = 0.5 + 0.5 * sin(q.x * 300.0) * sin(q.y * 300.0);
			float3 mid_c = lerp(float3(1.0, 0.8, 0.25), float3(0.65, 0.38, 0.12), dots * 0.5);
			col = over(col, mid_c * (0.9 + 0.3 * bd.b), ca);
		}
	}

	/* a grassy hill */
	float hill = ground - 0.012 * sin(p.x * 3.0 + 1.0) - 0.006 * sin(p.x * 11.0);
	float blades = 0.008 * abs(sin(p.x * 160.0 + sin(time * 1.3 + p.x * 4.0) * 0.6)) * (1.0 + level);
	float ga = smoothstep(hill - blades - px, hill - blades + px, p.y);
	float3 grass = lerp(float3(0.16, 0.5, 0.22), prism(hue + 0.38), 0.2 * pal_mix) * (0.7 + 0.3 * (1.0 - (p.y - hill) * 8.0));
	col = over(col, grass, ga);
	return finish_paint(col, uv);
}

/* ------------------------------------------------------------------ */
/* disco ball: a mirror ball throwing spinning beams and spots         */

float4 PSDiscoBall(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);
	float R = 0.13 * (1.0 + 0.04 * bass);
	float2 bc = float2(aspect * 0.5, 0.24);
	float2 q = p - bc;
	float r = length(q);
	float ang = atan2(q.y, q.x);
	float3 light = float3(0.0, 0.0, 0.0);

	/* beams */
	float beams = 6.0 + floor(4.0 * max(density, 0.3));
	float a01 = frac(ang / 6.2831853 + time * 0.04);
	float bi = floor(a01 * beams);
	float bf = a01 * beams - bi;
	float bseed = hash11(bi + 3.0);
	float4 bd = band_full(bseed);
	float aw = abs(bf - 0.5) / beams * 6.2831853 * max(r, 0.001);
	float bw = 0.006 + 0.04 * r;
	float beam = exp(-aw / bw) * step(R, r) * exp(-r / (0.6 + 0.5 * level));
	light += prism(hue + bseed + bi / beams) * beam * (0.25 + 1.4 * bd.r + 0.8 * beat);

	/* spots swirling around the room */
	float2 sp = float2(frac(ang / 6.2831853 + time * 0.04) * 40.0, r * 22.0);
	float2 cell = floor(sp);
	float h = hash21(float2(glmod(cell.x, 40.0), cell.y));
	float2 f = frac(sp) - 0.5;
	float spot = smoothstep(0.8, 1.0, h) * exp(-dot(f, f) * 9.0) * step(R * 1.2, r);
	light += prism(hue + h * 2.0) * spot * (0.3 + 1.6 * band_level(h) + 0.8 * beat) * 0.9;

	/* glare */
	light += prism(hue + 0.1) * exp(-r / (0.06 + 0.05 * level)) * (0.25 + 0.7 * beat);

	float4 col = finish(light, uv);

	/* the string */
	float sa = (1.0 - smoothstep(px * 0.5, px * 1.5, abs(p.x - bc.x))) * step(p.y, bc.y - R);
	col = over(col, float3(0.55, 0.55, 0.6), sa * grade.z);

	/* the ball: mirror tiles on a sphere that turns */
	BRANCH
	if (r < R + px * 2.0) {
		float2 nq = q / R;
		float z = sqrt(saturate(1.0 - dot(nq, nq)));
		float lat = asin(clamp(nq.y, -1.0, 1.0));
		float lon = atan2(nq.x, z) + time * 0.6;
		float rows = 12.0;
		float2 tp = float2(lon / 6.2831853 * rows * 2.0, lat / 3.1415927 * rows);
		float2 tc = floor(tp);
		float2 tf = frac(tp) - 0.5;
		float th = hash21(float2(glmod(tc.x, rows * 2.0), tc.y));
		float edge = smoothstep(0.42, 0.5, max(abs(tf.x), abs(tf.y)));
		float glint = smoothstep(0.82, 1.0, th) * (0.5 + 0.5 * sin(time * 6.0 + th * 50.0));
		float shade = 0.35 + 0.65 * z;
		float3 tile = lerp(float3(0.55, 0.57, 0.65), prism(hue + th), 0.35) * shade * (0.75 + 0.5 * th);
		tile = lerp(tile, float3(1.0, 1.0, 1.0), saturate(glint * (0.6 + 1.2 * treble + 0.8 * beat)));
		tile *= 1.0 - 0.6 * edge;
		/* highlight */
		float2 hl = nq - float2(-0.35, -0.4);
		tile += float3(1.0, 1.0, 1.0) * exp(-dot(hl, hl) * 18.0) * 0.5;
		float ba = 1.0 - smoothstep(R - px, R + px, r);
		col = over(col, min(graded(tile), float3(1.0, 1.0, 1.0)), ba * grade.z);
	}
	return col;
}

/* ------------------------------------------------------------------ */
/* pixel EQ: a chunky 8-bit equalizer                                  */

float4 PSPixelEQ(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);
	float cols = max(floor(16.0 * max(density, 0.3)), 6.0);
	float rows = 14.0;
	float left = aspect * 0.08;
	float width = aspect * 0.84;
	float top = 0.1;
	float bottom = 0.86;
	float4 col = float4(0.0, 0.0, 0.0, 0.0);

	float cw = width / cols;
	float rh = (bottom - top) / rows;
	float cx = (p.x - left) / cw;
	float ry = (bottom - p.y) / rh;
	float i = floor(cx);
	float j = floor(ry);
	float2 f = float2(cx - i, ry - j);

	BRANCH
	if (i >= 0.0 && i < cols && j >= 0.0 && j < rows) {
		float side = abs((i + 0.5) / cols - 0.5) * 2.0;
		float4 bd = band_full(side * 0.95);
		float lvl = bd.r * rows;
		float pk = floor(bd.g * rows);
		float fr = j / rows;
		float3 retro = fr < 0.6 ? float3(0.25, 1.0, 0.35) : (fr < 0.82 ? float3(1.0, 0.86, 0.2) : float3(1.0, 0.28, 0.25));
		float3 c = lerp(retro, prism(hue + fr * 0.5 + side * 0.15), 0.12 + 0.88 * pal_mix);
		/* the block, its gap, and a pixel-art bevel */
		float gap = 0.14;
		float inside = step(gap, f.x) * step(f.x, 1.0 - gap) * step(gap, f.y) * step(f.y, 1.0 - gap);
		float bevel = step(f.y, 1.0 - gap) * step(1.0 - gap - 0.16, f.y) + step(gap, f.x) * step(f.x, gap + 0.12);
		float lit_on = step(j + 0.5, lvl); /* lit is an HLSL intrinsic */
		float peak = step(abs(j - pk), 0.5) * step(1.0, pk);
		float3 block = c * (1.0 + 0.3 * bd.b);
		block = lerp(block, float3(1.0, 1.0, 1.0), saturate(bevel) * 0.2 + peak * (1.0 - lit_on) * 0.45);
		col = over(col, c * 0.1, inside * 0.5);
		col = over(col, block, inside * max(lit_on, peak));
	}

	/* scanlines and a floor glow */
	col.rgb *= 0.88 + 0.12 * step(0.5, frac(p.y * res.y / 3.0));
	float below = p.y - bottom;
	float fl = step(0.0, below) * exp(-below / 0.04) * (0.15 + 0.5 * level);
	col = over(col, prism(hue + 0.2), fl * step(left, p.x) * step(p.x, left + width) * 0.6);
	return finish_paint(col, uv);
}

/* ------------------------------------------------------------------ */
/* DNA helix: two strands of beads twisting, the rungs light up with   */
/* their band                                                           */

float4 PSDNAHelix(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);
	float spacing = 0.045 / max(density, 0.3);
	float A = 0.15 + 0.03 * bass + 0.02 * beat;
	float k = 6.2831853 / 0.9;
	/* 2 turns per flow wrap */
	float phase = flow * 0.19634954;
	float4 col = float4(0.0, 0.0, 0.0, 0.0);
	float3 glowl = float3(0.0, 0.0, 0.0);

	float ci = floor(p.x / spacing + 0.5);
	/* back beads, rungs, then front beads */
	for (int pass_i = 0; pass_i < 3; pass_i++) {
		for (int o = -1; o <= 1; o++) {
			float i = ci + float(o);
			float x = i * spacing;
			float th = x * k - phase;
			float e = band_level(saturate(abs(x / aspect - 0.5) * 2.0));
			float3 c1 = prism(hue + x / aspect * 0.6);
			float3 c2 = prism(hue + 0.5 + x / aspect * 0.6);
			float ya = 0.5 + A * sin(th);
			float yb = 0.5 - A * sin(th);
			float za = cos(th);
			if (pass_i == 1) {
				/* the rung */
				float ra = (1.0 - smoothstep(px * 1.2, px * 2.4, abs(p.x - x))) * step(min(ya, yb), p.y) *
					   step(p.y, max(ya, yb));
				float3 rc = p.y < 0.5 ? (ya < yb ? c1 : c2) : (ya < yb ? c2 : c1);
				col = over(col, rc * (0.35 + 0.9 * e), ra * (0.35 + 0.6 * e));
				glowl += rc * exp(-abs(p.x - x) / (px * 3.0)) * step(min(ya, yb), p.y) * step(p.y, max(ya, yb)) * e * 0.5;
			} else {
				for (int s = 0; s < 2; s++) {
					float z = s == 0 ? za : -za;
					float front = z > 0.0 ? 1.0 : 0.0;
					if ((pass_i == 2) == (front > 0.5)) {
						float y = s == 0 ? ya : yb;
						float br = spacing * (0.26 + 0.1 * z) * (1.0 + 0.5 * e);
						float d = length(p - float2(x, y));
						float a = 1.0 - smoothstep(br - px, br + px, d);
						float3 c = s == 0 ? c1 : c2;
						float shade = 0.7 + 0.3 * z;
						float2 hl = (p - float2(x, y)) / br + float2(0.35, 0.35);
						float3 bead = lerp(c * shade, float3(1.0, 1.0, 1.0), exp(-dot(hl, hl) * 4.0) * 0.6 * (0.5 + 0.5 * z));
						col = over(col, bead * (0.85 + 0.4 * e), a);
						glowl += c * exp(-d / (br * 1.8)) * (0.15 + 0.6 * e + 0.3 * beat) * (0.6 + 0.4 * z);
					}
				}
			}
		}
	}
	/* a soft glow around it all, then the solid helix on top */
	float4 base = finish(glowl, uv);
	float3 rgb = min(graded(col.rgb), float3(1.0, 1.0, 1.0));
	return over(base, rgb, col.a * grade.z);
}

/* ------------------------------------------------------------------ */
/* plasma globe: lightning reaching out to the glass                   */

float4 PSPlasmaGlobe(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);
	float R = 0.3;
	float2 gc = float2(aspect * 0.5, 0.46);
	float2 q = p - gc;
	float r = length(q);
	float ang = atan2(q.y, q.x);
	float3 light = float3(0.0, 0.0, 0.0);
	float n = floor(6.0 + 4.0 * max(density, 0.3));

	BRANCH
	if (r < R * 1.08) {
		for (int t = 0; t < 14; t++) {
			float tf = float(t);
			if (tf < n) {
				float seed = hash11(tf * 7.3 + 0.4);
				float4 bd = band_full(seed);
				/* each tendril drifts around slowly, and wriggles */
				float base_a = tf / n * 6.2831853 + sin(time * (0.2 + 0.25 * seed) + seed * 20.0) * 0.9;
				float wig = (0.12 * sin(r * 16.0 + time * (4.0 + 3.0 * seed) + seed * 30.0) +
					     0.06 * sin(r * 37.0 - time * 7.0 + seed * 11.0)) *
					    (0.4 + 1.6 * r / R) * (0.6 + 0.8 * treble);
				float da = abs(frac((ang - base_a - wig) / 6.2831853 + 0.5) - 0.5) * 6.2831853 * r;
				float reach = R * (0.55 + 0.45 * saturate(bd.r * 1.6 + beat * 0.5));
				float along = step(r, reach) * smoothstep(0.0, 0.03, r);
				float energy = 0.3 + 1.6 * bd.r + 1.0 * bd.b + 0.6 * beat;
				float3 tint = lerp(prism(hue + seed * 0.3), float3(1.0, 0.9, 1.0), 0.35);
				light += tint * (exp(-da / (px * 1.2)) * 1.6 + exp(-da / (0.012 + 0.01 * bd.r)) * 0.3) * along * energy;
				/* where it touches the glass */
				float2 tip = float2(cos(base_a + wig), sin(base_a + wig)) * reach;
				light += tint * exp(-length(q - tip) / (0.012 + 0.02 * bd.r)) * energy * 0.6 * step(R * 0.9, reach);
			}
		}
	}
	/* the electrode in the middle */
	float3 core_c = lerp(prism(hue), float3(1.0, 0.85, 1.0), 0.4);
	light += core_c * (exp(-r / 0.012) * 2.0 + exp(-r / (0.05 + 0.04 * bass)) * (0.4 + 0.8 * beat));
	/* the glass: a thin rim, a faint fill and a highlight */
	light += prism(hue + 0.6) * exp(-abs(r - R) / (px * 1.4)) * 0.5;
	light += prism(hue + 0.6) * step(r, R) * 0.05 * (0.6 + level);
	float2 hl = q - float2(-0.13, -0.16);
	light += float3(1.0, 1.0, 1.0) * exp(-dot(hl, hl) / 0.0006) * 0.3;

	float4 col = finish(light, uv);
	/* the stand */
	float sy = p.y - (gc.y + R * 0.92);
	float sw = 0.1 + sy * 0.6;
	float sa = step(0.0, sy) * step(sy, 0.11) * (1.0 - smoothstep(sw - px, sw + px, abs(q.x)));
	float3 stand = float3(0.12, 0.11, 0.15) + prism(hue + 0.6) * 0.06 * exp(-sy / 0.02);
	stand *= 1.0 - 0.4 * abs(q.x) / max(sw, 0.001);
	col = over(col, min(graded(stand), float3(1.0, 1.0, 1.0)), sa * grade.z);
	return col;
}

/* ------------------------------------------------------------------ */
/* ocean sunset: waves rolling in to the music under a setting sun     */

float wave_y(float x, float layer, float e)
{
	float base = 0.6 + layer * 0.075;
	float amp = (0.006 + 0.01 * layer) * (1.0 + 2.5 * e);
	/* 1 wave per 8 units of flow per layer: seamless at the wrap */
	float t = flow * 0.78539816;
	return base + amp * sin(x * (9.0 - layer) + t + layer * 1.7) + amp * 0.5 * sin(x * (17.0 - layer) - t + layer);
}

float4 PSOceanSunset(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);
	float horizon = 0.58;
	float4 col = float4(0.0, 0.0, 0.0, 0.0);
	float k = 0.3 + 0.7 * pal_mix;
	float3 sun_c = lerp(float3(1.0, 0.72, 0.3), prism(hue), k);
	float3 sea_c = lerp(float3(0.2, 0.32, 0.6), prism(hue + 0.55), 0.4 * pal_mix);

	/* a warm sky near the horizon */
	col = over(col, sun_c * 0.8, exp(-max(horizon - p.y, 0.0) / (0.12 + 0.05 * level)) * 0.35 * step(p.y, horizon));

	/* the sun and its glow, sinking into the sea */
	float2 sc = float2(aspect * 0.5, horizon - 0.06);
	float R = 0.12 * (1.0 + 0.05 * bass + 0.03 * beat);
	float sd = length(p - sc);
	col = over(col, sun_c, saturate(exp(-max(sd - R, 0.0) / (0.08 + 0.06 * level)) * 0.5) * step(p.y, horizon));
	col = over(col, lerp(sun_c, float3(1.0, 1.0, 0.9), 0.3), (1.0 - smoothstep(R - px, R + px, sd)) * step(p.y, horizon));

	/* birds */
	for (int b = 0; b < 2; b++) {
		float bf = float(b);
		float bx = frac(time * 0.03 * (1.0 + bf * 0.4) + bf * 0.5) * (aspect + 0.2) - 0.1;
		float2 bq = p - float2(bx, 0.2 + bf * 0.08 + 0.01 * sin(time * 1.5 + bf));
		float flap = 0.4 + 0.5 * sin(time * 8.0 + bf * 2.0);
		float wing = abs(bq.y + abs(bq.x) * flap);
		float ba = (1.0 - smoothstep(px * 0.8, px * 1.8, wing)) * step(abs(bq.x), 0.018);
		col = over(col, lerp(float3(0.95, 0.9, 0.95), sun_c, 0.3), ba * 0.85);
	}

	/* the sea, back to front */
	for (int l = 0; l < 5; l++) {
		float lf = float(l);
		float e = band_level(lf / 5.0 * 0.8 + 0.05);
		float y = wave_y(p.x, lf, e);
		float a = smoothstep(y - px, y + px, p.y);
		float depth = lf / 4.0;
		float3 water = lerp(sea_c * 0.55, sea_c * (0.9 + 0.3 * e), depth);
		water = lerp(water, sun_c, 0.12 * (1.0 - depth));
		/* the sun's path on the water */
		float path = exp(-abs(p.x - sc.x) / (0.05 + 0.1 * (p.y - horizon))) *
			     (0.5 + 0.5 * sin(p.y * 220.0 + flow * 3.1415927 + p.x * 30.0));
		water += sun_c * path * 0.5 * (1.0 - depth * 0.6) * (0.6 + level);
		col = over(col, water, a);
		/* foam on the crest */
		float foam = exp(-abs(p.y - y) / (px * (0.8 + 0.4 * lf))) * (0.12 + 0.6 * e + 0.3 * beat);
		col = over(col, float3(1.0, 1.0, 1.0), saturate(foam) * step(y - px * 4.0, p.y));
	}
	return finish_paint(col, uv);
}

/* ------------------------------------------------------------------ */

/* ------------------------------------------------------------------ */
/* the SPAZZamp player: a little retro music player on stream, with   */
/* its LCD clock, scrolling title and mini visualizer, in a few skins */
/* (0 SPAZZamp, 1 Classic, 2 Neon, 3 Synthwave, 4 CRT, 5 Glitch).      */
/* Laid out in "units" on a 275 x 116 window, like the old players.   */

float pl_cover(float d, float px)
{
	return saturate(0.5 - d / px);
}

float pl_box(float2 p, float2 lo, float2 hi, float r)
{
	float2 c = (lo + hi) * 0.5;
	float2 hs = (hi - lo) * 0.5;
	float2 d = abs(p - c) - hs + r;
	return length(max(d, float2(0.0, 0.0))) + min(max(d.x, d.y), 0.0) - r;
}

float pl_seg(float2 p, float2 a, float2 b)
{
	float2 pa = p - a;
	float2 ba = b - a;
	float h = saturate(dot(pa, ba) / dot(ba, ba));
	return length(pa - ba * h);
}

float3 pl_hsv(float h, float s, float v)
{
	float3 k = saturate(abs(frac(h + float3(0.0, 0.6667, 0.3333)) * 6.0 - 3.0) - 1.0);
	return v * lerp(float3(1.0, 1.0, 1.0), k, s);
}

/* the accent: fixed (0), cycling like the SPAZZamp dock (1), the palette
 * (2), a two-colour scheme (3), channels cycling on their own (4), or a
 * rainbow sweeping across the player (5: cycling, shifted by position) */
float3 pl_col(float shift)
{
	float3 cyc = pl_hsv(pl_look.z + shift, 0.66, 1.0);
	float3 pal = prism(hue + shift);
	float3 c = pl_look.w < 0.5 ? pl_accent : (pl_look.w < 1.5 ? cyc : pal);
	float3 scheme = lerp(pl_accent, pl_accent2, 0.5 - 0.5 * cos(shift * 9.42477796));
	float tz = (pl_look.z + shift) * 6.2831853;
	float3 spl = 0.5 + 0.5 * sin(float3(tz, 2.0 * tz + 2.1, 3.0 * tz + 4.2));
	spl = spl / max(max(spl.r, max(spl.g, spl.b)), 0.05);
	c = pl_look.w > 2.5 && pl_look.w < 3.5 ? scheme : c;
	c = pl_look.w > 3.5 && pl_look.w < 4.5 ? spl : c;
	c = pl_look.w > 4.5 ? cyc : c;
	return c;
}

/* ---- pixel font ---- */

float pl_char(float row, float idx)
{
	float v = text_tex.SampleLevel(font_sampler, float2((idx + 0.5) / 256.0, (row + 0.5) / 4.0), 0.0).r;
	return floor(v * 255.0 + 0.5);
}

float pl_glyph(float code, float2 g)
{
	float2 t = float2((code * 6.0 + floor(g.x) + 0.5) / 576.0, (floor(g.y) + 0.5) / 8.0);
	return font_tex.SampleLevel(font_sampler, t, 0.0).r;
}

/* the font pixel at q (in font pixels from the text's top-left) */
float pl_font_px(float2 q, float row, float start, float count, float scroll, float loop_len)
{
	float inside = step(0.0, q.x) * step(0.0, q.y) * step(q.y, 7.99) * step(q.x, count * 6.0 - 0.01);
	float x = q.x + frac(scroll) * 6.0;
	float cell = floor(x / 6.0);
	float idx = cell + floor(scroll);
	idx = loop_len > 0.5 ? glmod(idx, loop_len) : idx;
	float2 g = float2(x - cell * 6.0, q.y);
	float code = pl_char(row, start + idx);
	/* Corrupted: letters turn to garbage on the hits */
	float junk = step(1.0 - pl_glitch.w, hash21(float2(idx * 1.37 + row * 7.1, pl_glitch.z)));
	code = lerp(code, floor(hash21(float2(idx + row * 3.3, pl_glitch.z + 3.7)) * 94.0) + 1.0, junk);
	return pl_glyph(code, g) * inside;
}

/* LCD-dot text: "count" characters of text row "row" from "start", its
 * top-left at o, one font pixel "fp" units; scrolls when loop_len > 0 */
float pl_text(float2 p, float2 o, float fp, float px, float row, float start, float count, float scroll,
	      float loop_len)
{
	float2 q = (p - o) / fp;
	BRANCH
	if (q.x < -1.0 || q.y < -1.0 || q.y > 9.0 || q.x > count * 6.0 + 1.0) {
		return 0.0;
	}
	float on = pl_font_px(q, row, start, count, scroll, loop_len);
	float2 f = abs(frac(q + float2(frac(scroll) * 6.0, 0.0)) - 0.5);
	float aa = px / fp;
	float dot_r = lerp(0.42, 0.52, saturate(aa * 2.5));
	return on * (1.0 - smoothstep(dot_r - aa * 0.5, dot_r + aa * 0.5, max(f.x, f.y)));
}

/* a soft glow around the same text, for the neon-ish skins */
float pl_text_glow(float2 p, float2 o, float fp, float row, float start, float count, float scroll,
		   float loop_len)
{
	float2 q = (p - o) / fp;
	float g = 0.0;
	BRANCH
	if (q.x > -2.0 && q.y > -2.0 && q.y < 10.0 && q.x < count * 6.0 + 2.0) {
		float sx = frac(scroll) * 6.0;
		float2 base = float2(floor(q.x + sx) - sx, floor(q.y));
		for (int j = -1; j <= 1; j++) {
			for (int i = -1; i <= 1; i++) {
				float2 cq = base + float2(float(i), float(j)) + 0.5;
				float on = pl_font_px(cq, row, start, count, scroll, loop_len);
				float2 d = q - cq;
				g += on * exp(-dot(d, d) * 0.8);
			}
		}
	}
	return saturate(g * 0.5);
}

/* ---- 7-segment clock digits ---- */

float pl_digit_mask(float d)
{
	return d < -0.5 ? 0.0
	       : (d < 0.5 ? 63.0
	       : (d < 1.5 ? 6.0
	       : (d < 2.5 ? 91.0
	       : (d < 3.5 ? 79.0
	       : (d < 4.5 ? 102.0
	       : (d < 5.5 ? 109.0 : (d < 6.5 ? 125.0 : (d < 7.5 ? 7.0 : (d < 8.5 ? 127.0 : (d < 9.5 ? 111.0 : 64.0))))))))));
}

float pl_bit(float m, float b)
{
	return glmod(floor(m / exp2(b) + 0.001), 2.0);
}

/* x: lit, y: unlit ghost, z: glow around the lit segments */
float3 pl_seven(float2 p, float2 o, float w, float h, float m, float px)
{
	float2 q = p - o;
	q.x -= (h - q.y) * 0.1; /* a little italic, like an LCD */
	float3 r = float3(0.0, 0.0, 0.0);
	BRANCH
	if (q.x > -4.0 && q.y > -4.0 && q.x < w + 4.0 && q.y < h + 4.0) {
		float t = w * 0.12;
		float hm = h * 0.5;
		float ins = t * 1.7;
		float sa = pl_seg(q, float2(ins, t), float2(w - ins, t)) - t;
		float sb = pl_seg(q, float2(w - t, ins), float2(w - t, hm - ins * 0.55)) - t;
		float sc = pl_seg(q, float2(w - t, hm + ins * 0.55), float2(w - t, h - ins)) - t;
		float sd = pl_seg(q, float2(ins, h - t), float2(w - ins, h - t)) - t;
		float se = pl_seg(q, float2(t, hm + ins * 0.55), float2(t, h - ins)) - t;
		float sf = pl_seg(q, float2(t, ins), float2(t, hm - ins * 0.55)) - t;
		float sg = pl_seg(q, float2(ins, hm), float2(w - ins, hm)) - t;
		float ba = pl_bit(m, 0.0);
		float bb = pl_bit(m, 1.0);
		float bc = pl_bit(m, 2.0);
		float bd = pl_bit(m, 3.0);
		float be = pl_bit(m, 4.0);
		float bf = pl_bit(m, 5.0);
		float bg_ = pl_bit(m, 6.0);
		float big = 1000.0;
		float dl = min(min(min(lerp(big, sa, ba), lerp(big, sb, bb)), min(lerp(big, sc, bc), lerp(big, sd, bd))),
			       min(min(lerp(big, se, be), lerp(big, sf, bf)), lerp(big, sg, bg_)));
		float du = min(min(min(lerp(big, sa, 1.0 - ba), lerp(big, sb, 1.0 - bb)),
				   min(lerp(big, sc, 1.0 - bc), lerp(big, sd, 1.0 - bd))),
			       min(min(lerp(big, se, 1.0 - be), lerp(big, sf, 1.0 - bf)), lerp(big, sg, 1.0 - bg_)));
		r = float3(pl_cover(dl, px), pl_cover(du, px), exp(-max(dl, 0.0) / max(t * 2.2, px)));
	}
	return r;
}

/* ---- the little visualizers ---- */

float3 pl_bar_col(float y, float x, float skin)
{
	float3 c = lerp(pl_col(x * 0.25) * 0.55, pl_col(0.08 + x * 0.25), saturate(y * 1.6));
	c = lerp(c, float3(1.0, 1.0, 1.0), saturate(y - 0.85) * 1.5);
	/* the classic: green, then yellow, then red at the top */
	float3 classic = y < 0.55 ? float3(0.1, 0.9, 0.25) : (y < 0.8 ? float3(1.0, 0.85, 0.15) : float3(1.0, 0.25, 0.15));
	c = skin > 0.5 && skin < 1.5 && pl_look.w < 0.5 ? classic : c;
	/* CRT: one phosphor colour */
	c = skin > 3.5 && skin < 4.5 ? pl_col(0.0) * (0.45 + 0.55 * y) : c;
	return c;
}

/* kind: 0 bars, 1 oscilloscope, 2 aurora, 3 LED peaks */
float4 pl_viz(float2 p, float2 lo, float2 hi, float kind, float skin, float px)
{
	float2 sz = hi - lo;
	float2 q = (p - lo) / sz;
	float4 c = float4(0.0, 0.0, 0.0, 0.0);
	BRANCH
	if (q.x >= 0.0 && q.x <= 1.0 && q.y >= 0.0 && q.y <= 1.0) {
		float yup = 1.0 - q.y;
		float pxy = px / sz.y;
		if (kind < 0.5) {
			float n = floor(clamp(sz.x / 4.6 * density, 8.0, 64.0));
			float i = floor(q.x * n);
			float fx = frac(q.x * n);
			float4 bd = band_full((i + 0.5) / n);
			float gx = step(0.14, fx) * step(fx, 0.86);
			float bar = gx * (1.0 - smoothstep(bd.r - pxy, bd.r + pxy, yup));
			c = over(c, pl_bar_col(yup, i / n, skin) * (1.0 + 0.4 * bd.b), bar);
			float cap = gx * (1.0 - smoothstep(pxy * 0.8, pxy * 2.0, abs(yup - max(bd.g, 0.02))));
			c = over(c, lerp(pl_bar_col(1.0, i / n, skin), float3(1.0, 1.0, 1.0), 0.5), cap * 0.9);
		} else if (kind < 1.5) {
			float a = 0.0;
			for (int k = 1; k <= 7; k++) {
				float kf = float(k);
				float e = band_level(kf / 8.0);
				a += e * sin(q.x * 6.2831853 * (kf * 1.35 + 0.6) + time * (2.0 + kf * 1.7) + kf * 1.9) /
				     sqrt(kf);
			}
			float y = 0.5 - a * 0.36 * (0.7 + 0.6 * level);
			float d = abs(q.y - y) * sz.y;
			float3 lc = pl_col(q.x * 0.3);
			c = over(c, lc, exp(-d / 1.6) * 0.45);
			c = over(c, lerp(lc, float3(1.0, 1.0, 1.0), 0.35), pl_cover(d - 0.45, px));
			/* faint centre line */
			c = over(c, lc, pl_cover(abs(q.y - 0.5) * sz.y - 0.15, px) * 0.15);
		} else if (kind < 2.5) {
			float e = band_level(abs(q.x - 0.5) * 2.0);
			float wv = 0.07 * sin(q.x * 17.0 + time * 2.3) + 0.04 * sin(q.x * 31.0 - time * 3.1);
			float top = 1.0 - (0.15 + 0.85 * e) + wv;
			float curtain = smoothstep(top - 0.08, top + 0.06, q.y) * (1.0 - smoothstep(top + 0.05, 1.05, q.y) * 0.75);
			float rays = 0.65 + 0.35 * sin(q.x * 70.0 + time * 4.0 + sin(q.x * 9.0) * 3.0);
			float3 ac = lerp(pl_col(q.x * 0.5 + 0.1), pl_col(q.x * 0.5 + 0.45), saturate((q.y - top) * 2.0));
			c = over(c, ac, curtain * rays * (0.45 + 0.55 * e));
			c = over(c, lerp(ac, float3(1.0, 1.0, 1.0), 0.4), exp(-abs(q.y - top) * sz.y / 0.8) * (0.3 + 0.7 * e));
		} else {
			float n = floor(clamp(sz.x / 6.0 * density, 6.0, 48.0));
			float rows = max(floor(sz.y / 2.6), 4.0);
			float i = floor(q.x * n);
			float j = floor(yup * rows);
			float2 f = float2(frac(q.x * n), frac(yup * rows));
			float4 bd = band_full((i + 0.5) / n);
			float cell = step(0.12, f.x) * step(f.x, 0.88) * step(0.16, f.y) * step(f.y, 0.84);
			float on = step(j + 0.5, bd.r * rows);
			float pk = step(abs(j - floor(bd.g * rows)), 0.5) * step(0.03, bd.g);
			float3 lc = pl_bar_col(j / rows, i / n, skin);
			c = over(c, lc, cell * 0.08);
			c = over(c, lc, cell * on);
			c = over(c, lerp(lc, float3(1.0, 1.0, 1.0), 0.6), cell * pk * (1.0 - on));
		}
	}
	return c;
}

/* ---- panels ---- */

/* an LCD well: dark inset with a faint dot grid */
float4 pl_well(float4 c, float2 p, float2 lo, float2 hi, float px, float3 lcd, float3 acc, float neon)
{
	float d = pl_box(p, lo, hi, 2.5);
	float cov = pl_cover(d, px);
	c = over(c, lcd, cov * lerp(1.0, 0.85, neon));
	float2 g = abs(frac((p - lo) / 2.0) - 0.5);
	c = over(c, float3(1.0, 1.0, 1.0), cov * (1.0 - smoothstep(0.12, 0.2, max(g.x, g.y))) * 0.035);
	/* inset: dark rim, a light line along the bottom */
	c = over(c, float3(0.0, 0.0, 0.0), pl_cover(abs(d + 0.35) - 0.35, px) * 0.8 * (1.0 - neon));
	c = over(c, float3(1.0, 1.0, 1.0),
		 pl_cover(abs(p.y - (hi.y - 0.6)) - 0.25, px) * step(lo.x + 2.0, p.x) * step(p.x, hi.x - 2.0) * 0.07 *
			 (1.0 - neon));
	/* neon: a glowing outline instead */
	c = over(c, acc, neon * (pl_cover(abs(d) - 0.3, px) * 0.95 + exp(-abs(d) / 1.4) * 0.35));
	return c;
}

/* a raised button */
float4 pl_button(float4 c, float2 p, float2 lo, float2 hi, float px, float3 face, float3 acc, float neon)
{
	float d = pl_box(p, lo, hi, 2.0);
	float cov = pl_cover(d, px);
	float t = saturate((p.y - lo.y) / max(hi.y - lo.y, 1.0));
	float3 f = lerp(face * 1.45, face * 0.75, t);
	c = over(c, f, cov * (1.0 - neon * 0.8));
	c = over(c, float3(1.0, 1.0, 1.0), pl_cover(abs(p.y - lo.y - 0.9) - 0.3, px) * cov * 0.12 * (1.0 - neon));
	c = over(c, float3(0.0, 0.0, 0.0), pl_cover(abs(d + 0.3) - 0.3, px) * 0.85 * (1.0 - neon));
	c = over(c, acc, neon * (pl_cover(abs(d) - 0.3, px) * 0.9 + exp(-abs(d) / 1.2) * 0.25));
	return c;
}

/* transport glyphs, centred at m: 0 prev, 1 play, 2 pause, 3 stop, 4 next, 5 eject */
float pl_icon(float2 p, float2 m, float kind, float px)
{
	float2 q = p - m;
	float d = 100.0;
	if (kind < 0.5) {
		float2 r = q - float2(0.8, 0.0);
		d = min(max(r.x - 2.0, abs(r.y) - (2.6 + r.x) * 0.72), pl_box(q, float2(-4.0, -2.8), float2(-2.8, 2.8), 0.2));
	} else if (kind < 1.5) {
		float2 r = q - float2(0.4, 0.0);
		d = max(-r.x - 2.6, abs(r.y) - (3.0 - r.x) * 0.62);
	} else if (kind < 2.5) {
		d = min(pl_box(q, float2(-2.6, -2.8), float2(-0.7, 2.8), 0.2), pl_box(q, float2(0.7, -2.8), float2(2.6, 2.8), 0.2));
	} else if (kind < 3.5) {
		d = pl_box(q, float2(-2.6, -2.6), float2(2.6, 2.6), 0.3);
	} else if (kind < 4.5) {
		float2 r = q + float2(0.8, 0.0);
		d = min(max(-r.x - 2.0, abs(r.y) - (2.6 - r.x) * 0.72), pl_box(q, float2(2.8, -2.8), float2(4.0, 2.8), 0.2));
	} else {
		d = min(max(q.y - 0.4, abs(q.x) - (q.y + 3.4) * 0.85), pl_box(q, float2(-2.9, 1.6), float2(2.9, 2.8), 0.2));
	}
	return pl_cover(d, px);
}

float4 pl_draw(float2 p, float px, float skin)
{
	float W = 275.0;
	float strip_on = step(-0.5, pl_look.y);
	float H = lerp(98.0, 116.0, strip_on);
	float4 c = float4(0.0, 0.0, 0.0, 0.0);

	float st = pl_state.y;
	float playing = step(0.5, st) * step(st, 1.5);
	float paused = step(1.5, st) * step(st, 2.5);
	float going = max(playing, paused);

	/* the skin (a rainbow sweep shifts the colour along the window) */
	float sweep = step(4.5, pl_look.w) * (p.x / 275.0 + p.y / 420.0);
	float3 acc = pl_col(sweep);
	float3 acc2 = pl_col(0.33 + sweep);
	float3 body_a = float3(0.118, 0.110, 0.169);
	float3 body_b = float3(0.071, 0.067, 0.102);
	float3 lcd = float3(0.016, 0.020, 0.039);
	float3 ink = float3(0.42, 0.40, 0.52); /* small labels */
	float neon = 0.0;
	if (skin > 0.5 && skin < 1.5) {
		body_a = float3(0.30, 0.30, 0.38);
		body_b = float3(0.15, 0.15, 0.21);
		lcd = float3(0.0, 0.0, 0.0);
		ink = float3(0.75, 0.75, 0.82);
		acc2 = pl_look.w < 0.5 ? float3(1.0, 0.85, 0.2) : acc2;
	} else if (skin > 1.5 && skin < 2.5) {
		body_a = float3(0.035, 0.02, 0.06);
		body_b = float3(0.01, 0.0, 0.025);
		lcd = float3(0.005, 0.0, 0.02);
		ink = acc * 0.7;
		neon = 1.0;
		acc2 = pl_look.w < 0.5 ? float3(0.0, 0.9, 1.0) : acc2;
	} else if (skin > 2.5 && skin < 3.5) {
		body_a = float3(0.17, 0.05, 0.28);
		body_b = float3(0.05, 0.01, 0.10);
		lcd = float3(0.025, 0.0, 0.06);
		ink = float3(0.75, 0.55, 0.95);
		acc2 = pl_look.w < 0.5 ? float3(0.13, 0.9, 1.0) : acc2;
	} else if (skin > 3.5 && skin < 4.5) {
		body_a = float3(0.05, 0.085, 0.06);
		body_b = float3(0.02, 0.035, 0.025);
		lcd = float3(0.0, 0.025, 0.01);
		ink = acc * 0.55;
		acc2 = acc * 0.75;
	} else if (skin > 4.5) {
		body_a = float3(0.075, 0.075, 0.095);
		body_b = float3(0.03, 0.03, 0.04);
		lcd = float3(0.0, 0.0, 0.02);
		ink = float3(0.55, 0.55, 0.62);
		acc2 = pl_look.w < 0.5 ? float3(1.0, 0.17, 0.55) : acc2;
	}

	/* the window */
	float dw = pl_box(p, float2(0.0, 0.0), float2(W, H), 5.0);
	c = over(c, acc, neon * exp(-max(dw, 0.0) / 3.5) * step(0.0, dw) * 0.55);
	BRANCH
	if (dw > 14.0) {
		return c;
	}
	float win = pl_cover(dw, px);
	float3 body = lerp(body_a, body_b, saturate(p.y / H));
	body *= 0.965 + 0.035 * sin(p.y * 2.7 + sin(p.x * 0.05) * 2.0);
	/* synthwave: a sunset grid fading up the body */
	float gy = saturate((p.y - H * 0.55) / (H * 0.45));
	float grid = (pl_cover(abs(frac((p.x - W * 0.5) / (6.0 + 30.0 * (1.0 - gy)) + 0.5) - 0.5) * 6.0 - 0.15, px) +
		      pl_cover(abs(frac(gy * gy * 6.0 - time * 0.4) - 0.5) * 8.0 - 0.15, px)) * gy;
	body = skin > 2.5 && skin < 3.5 ? body + acc * grid * 0.12 : body;
	c = over(c, body, win * lerp(1.0, 0.9, neon));
	float rim = pl_cover(abs(dw + 0.9) - 0.45, px);
	float3 rim_c = lerp(float3(1.0, 1.0, 1.0), float3(0.0, 0.0, 0.0), saturate(p.y / H + 0.2));
	c = over(c, rim_c, rim * 0.22 * (1.0 - neon));
	c = over(c, float3(0.0, 0.0, 0.0), pl_cover(abs(dw) - 0.45, px) * (1.0 - neon));
	c = over(c, acc, neon * pl_cover(abs(dw + 0.5) - 0.5, px));

	/* title bar */
	BRANCH
	if (pl_show.x > 0.5 && p.y < 15.0) {
		float tb = pl_box(p, float2(3.0, 2.5), float2(W - 3.0, 13.0), 2.0);
		float tbc = pl_cover(tb, px);
		float3 tbcol = lerp(body_a * 1.7, body_a * 1.15, saturate((p.y - 2.5) / 10.5));
		tbcol = skin > 0.5 && skin < 1.5 ? lerp(float3(0.16, 0.17, 0.42), float3(0.33, 0.35, 0.7), p.x / W) : tbcol;
		tbcol = skin > 2.5 && skin < 3.5 ? lerp(float3(1.0, 0.2, 0.55), float3(1.0, 0.62, 0.18), p.x / W) * 0.55 : tbcol;
		c = over(c, tbcol, tbc * (1.0 - neon));
		float grooves = (pl_cover(abs(p.y - 5.6) - 0.4, px) + pl_cover(abs(p.y - 8.0) - 0.4, px) +
				 pl_cover(abs(p.y - 10.4) - 0.4, px)) *
				(step(9.0, p.x) * step(p.x, 108.0) + step(167.0, p.x) * step(p.x, 238.0));
		c = over(c, lerp(ink, acc, 0.4 + 0.6 * neon), grooves * tbc * 0.45);
		float tt = pl_text(p, float2(114.0, 4.0), 1.0, px, 3.0, 0.0, 8.0, 0.0, 0.0);
		float3 tcol = skin > 0.5 && skin < 1.5 ? float3(0.92, 0.92, 1.0) : acc;
		tcol = skin > 2.5 && skin < 3.5 ? lerp(float3(1.0, 1.0, 1.0), acc2, 0.25) : tcol;
		c = over(c, tcol, pl_text_glow(p, float2(114.0, 4.0), 1.0, 3.0, 0.0, 8.0, 0.0, 0.0) * 0.5 * (1.0 - step(0.5, skin) * step(skin, 1.5)));
		c = over(c, tcol, tt);
		/* minimise / shade / close */
		for (int k = 0; k < 3; k++) {
			float kf = float(k);
			float2 bm = float2(247.0 + kf * 9.5, 7.75);
			c = pl_button(c, p, bm - 3.4, bm + 3.4, px, body_a * 1.2, acc, neon);
			float2 q = p - bm;
			float gd = kf < 0.5 ? pl_box(q, float2(-2.0, 1.0), float2(2.0, 1.9), 0.1)
				   : (kf < 1.5 ? abs(pl_box(q, float2(-1.9, -1.9), float2(1.9, 1.9), 0.2)) - 0.35
					       : min(pl_seg(q, float2(-1.8, -1.8), float2(1.8, 1.8)), pl_seg(q, float2(-1.8, 1.8), float2(1.8, -1.8))) - 0.45);
			c = over(c, lerp(ink, acc, neon), pl_cover(gd, px));
		}
	}

	/* ---- the LCD: state, clock and the mini visualizer ---- */
	c = pl_well(c, p, float2(8.0, 16.0), float2(104.0, 60.0), px, lcd, acc, neon);
	BRANCH
	if (p.x > 6.0 && p.x < 106.0 && p.y > 14.0 && p.y < 62.0) {
		/* play state */
		float2 gm = float2(15.5, 24.0);
		float blink = paused * step(0.45, frac(time * 1.1));
		float sg = playing > 0.5 ? pl_icon(p, gm, 1.0, px) : (paused > 0.5 ? pl_icon(p, gm, 2.0, px) : pl_icon(p, gm, 3.0, px));
		float2 gd = p - gm;
		c = over(c, acc, playing * exp(-dot(gd, gd) / 18.0) * 0.35);
		c = over(c, acc, sg * lerp(0.4, 1.0, going) * (1.0 - blink * 0.7));

		/* the clock: [-]mm:ss */
		float dimc = lerp(0.35, 1.0, going) * (1.0 - paused * step(0.55, frac(time * 1.1)) * 0.75);
		float3 d1 = pl_seven(p, float2(37.0, 20.0), 10.0, 17.0, pl_digit_mask(pl_digits.x), px);
		float3 d2 = pl_seven(p, float2(51.0, 20.0), 10.0, 17.0, pl_digit_mask(pl_digits.y), px);
		float3 d3 = pl_seven(p, float2(69.0, 20.0), 10.0, 17.0, pl_digit_mask(pl_digits.z), px);
		float3 d4 = pl_seven(p, float2(83.0, 20.0), 10.0, 17.0, pl_digit_mask(pl_digits.w), px);
		float3 dm = pl_seven(p, float2(24.0, 20.0), 9.0, 17.0, pl_info.w > 0.5 ? 64.0 : 0.0, px);
		float3 dd = max(max(d1, d2), max(d3, d4));
		dd.x = max(dd.x, dm.x);
		dd.z = max(dd.z, dm.z);
		float colon = max(pl_cover(length(p - float2(64.0, 25.0)) - 1.15, px), pl_cover(length(p - float2(63.0, 32.0)) - 1.15, px));
		c = over(c, acc, dd.y * 0.09);
		c = over(c, acc, dd.z * 0.3 * dimc);
		c = over(c, lerp(acc, float3(1.0, 1.0, 1.0), 0.2), max(dd.x, colon) * dimc);

		/* mini visualizer */
		float4 vz = pl_viz(p, float2(12.0, 41.0), float2(100.0, 57.0), pl_look.x, skin, px);
		c = over(c, vz.rgb, vz.a);
	}

	/* ---- the marquee ---- */
	c = pl_well(c, p, float2(108.0, 16.0), float2(268.0, 29.0), px, lcd, acc, neon);
	BRANCH
	if (p.x > 106.0 && p.y > 14.0 && p.y < 31.0) {
		float mq = pl_text(p, float2(113.0, 19.0), 1.0, px, 0.0, 0.0, 25.0, pl_state.z, pl_state.w);
		float3 mcol = skin > 2.5 && skin < 3.5 ? lerp(acc, acc2, saturate((p.y - 19.0) / 8.0)) : acc;
		float glow = neon + step(2.5, skin) * step(skin, 3.5) * 0.7 + step(3.5, skin) * 0.5;
		BRANCH
		if (glow > 0.0) {
			c = over(c, mcol, pl_text_glow(p, float2(113.0, 19.0), 1.0, 0.0, 0.0, 25.0, pl_state.z, pl_state.w) *
						  0.45 * glow);
		}
		c = over(c, mcol, mq * lerp(0.55, 1.0, step(0.5, st)));
	}

	/* ---- kbps / kHz / mono stereo ---- */
	BRANCH
	if (p.x > 106.0 && p.y > 30.0 && p.y < 44.0) {
		c = pl_well(c, p, float2(108.0, 32.0), float2(128.0, 42.0), px, lcd, acc, neon);
		c = pl_well(c, p, float2(153.0, 32.0), float2(168.0, 42.0), px, lcd, acc, neon);
		c = over(c, acc, pl_text(p, float2(109.5, 33.2), 1.0, px, 1.0, 0.0, 3.0, 0.0, 0.0));
		c = over(c, acc, pl_text(p, float2(155.0, 33.2), 1.0, px, 2.0, 0.0, 2.0, 0.0, 0.0));
		c = over(c, ink, pl_text(p, float2(131.0, 34.4), 0.85, px, 3.0, 9.0, 4.0, 0.0, 0.0));
		c = over(c, ink, pl_text(p, float2(171.0, 34.4), 0.85, px, 3.0, 14.0, 3.0, 0.0, 0.0));
		float stereo = pl_show.w;
		c = over(c, lerp(ink * 0.35, acc, 1.0 - stereo), pl_text(p, float2(197.0, 34.4), 0.85, px, 3.0, 18.0, 4.0, 0.0, 0.0));
		c = over(c, lerp(ink * 0.35, acc, stereo), pl_text(p, float2(222.0, 34.4), 0.85, px, 3.0, 23.0, 6.0, 0.0, 0.0));
	}

	/* ---- volume, balance, EQ / PL ---- */
	BRANCH
	if (p.x > 106.0 && p.y > 44.0 && p.y < 55.0) {
		float vol = saturate(pl_info.x);
		float vg = pl_box(p, float2(108.0, 46.5), float2(176.0, 50.5), 2.0);
		c = over(c, lcd, pl_cover(vg, px));
		float vx = 108.0 + 68.0 * vol;
		c = over(c, lerp(acc * 0.35, acc, saturate((p.x - 108.0) / 68.0)), pl_cover(vg + 0.6, px) * step(p.x, vx));
		c = pl_button(c, p, float2(vx - 3.5, 45.0), float2(vx + 3.5, 52.0), px, body_a * 1.5, acc, neon);
		float bgr = pl_box(p, float2(182.0, 46.5), float2(220.0, 50.5), 2.0);
		c = over(c, lcd, pl_cover(bgr, px));
		c = pl_button(c, p, float2(197.5, 45.0), float2(204.5, 52.0), px, body_a * 1.5, acc, neon);
		c = pl_button(c, p, float2(226.0, 44.5), float2(245.0, 53.0), px, body_a * 1.2, acc, neon);
		c = pl_button(c, p, float2(248.0, 44.5), float2(267.0, 53.0), px, body_a * 1.2, acc, neon);
		c = over(c, lerp(ink, acc, 0.5), pl_text(p, float2(231.2, 45.4), 0.85, px, 3.0, 39.0, 2.0, 0.0, 0.0));
		c = over(c, lerp(ink, acc, 0.5), pl_text(p, float2(253.2, 45.4), 0.85, px, 3.0, 42.0, 2.0, 0.0, 0.0));
	}

	/* ---- seek bar ---- */
	BRANCH
	if (pl_show.y > 0.5 && p.y > 61.0 && p.y < 72.0) {
		float sk = pl_box(p, float2(8.0, 63.5), float2(267.0, 69.5), 2.5);
		c = over(c, lcd, pl_cover(sk, px));
		float tx = 8.0 + 11.0 + saturate(pl_state.x) * (259.0 - 22.0);
		c = over(c, lerp(acc * 0.25, acc * 0.8, saturate((p.x - 8.0) / 259.0)), pl_cover(sk + 1.2, px) * step(p.x, tx) * going);
		c = pl_button(c, p, float2(tx - 11.0, 62.5), float2(tx + 11.0, 70.5), px, body_a * 1.6, acc, neon);
		c = over(c, ink, pl_cover(abs(p.x - tx) - 0.4, px) * step(64.5, p.y) * step(p.y, 68.5) * 0.6);
	}

	/* ---- transport, shuffle / repeat, logo ---- */
	BRANCH
	if (pl_show.z > 0.5 && p.y > 73.0 && p.y < 94.0) {
		for (int k = 0; k < 5; k++) {
			float kf = float(k);
			float2 lo = float2(8.0 + kf * 23.0, 75.0);
			float2 hi = lo + float2(21.0, 17.0);
			bool hit = abs(p.x - (lo.x + 10.5)) < 12.0;
			BRANCH
			if (hit) {
				c = pl_button(c, p, lo, hi, px, body_a * 1.25, acc, neon);
				float on = kf > 0.5 && kf < 1.5 ? playing : (kf > 1.5 && kf < 2.5 ? paused : (kf > 2.5 && kf < 3.5 ? (1.0 - going) * step(0.5, st) : 0.0));
				float3 gc = lerp(ink, acc, max(on, neon * 0.6));
				float ic = pl_icon(p, (lo + hi) * 0.5, kf < 0.5 ? 0.0 : (kf < 1.5 ? 1.0 : (kf < 2.5 ? 2.0 : (kf < 3.5 ? 3.0 : 4.0))), px);
				float2 gd = p - (lo + hi) * 0.5;
				c = over(c, acc, on * exp(-dot(gd, gd) / 20.0) * 0.35);
				c = over(c, gc, ic);
			}
		}
		c = pl_button(c, p, float2(124.0, 76.0), float2(143.0, 90.0), px, body_a * 1.25, acc, neon);
		c = over(c, lerp(ink, acc, neon * 0.6), pl_icon(p, float2(133.5, 83.0), 5.0, px));

		/* shuffle and repeat, with their lights */
		c = pl_button(c, p, float2(160.0, 77.0), float2(197.0, 89.0), px, body_a * 1.2, acc, neon);
		c = pl_button(c, p, float2(200.0, 77.0), float2(236.0, 89.0), px, body_a * 1.2, acc, neon);
		c = over(c, ink, pl_text(p, float2(164.0, 79.6), 0.85, px, 3.0, 30.0, 4.0, 0.0, 0.0));
		c = over(c, ink, pl_text(p, float2(204.0, 79.6), 0.85, px, 3.0, 35.0, 3.0, 0.0, 0.0));
		float shuf = pl_info.y;
		float rep = step(0.5, pl_info.z);
		float2 l1 = p - float2(191.0, 83.0);
		float2 l2 = p - float2(230.0, 83.0);
		c = over(c, acc, shuf * exp(-dot(l1, l1) / 6.0) * 0.5 + 0.0);
		c = over(c, lerp(lcd, acc, shuf), pl_cover(length(l1) - 1.7, px));
		c = over(c, acc, rep * exp(-dot(l2, l2) / 6.0) * 0.5);
		c = over(c, lerp(lcd, acc, rep), pl_cover(length(l2) - 1.7, px));
		c = over(c, acc, step(1.5, pl_info.z) * pl_text(p, float2(222.0, 79.6), 0.85, px, 3.0, 45.0, 1.0, 0.0, 0.0));

		/* the logo: a ring that kicks on the beat */
		float2 lg = p - float2(256.5, 83.0);
		float lr = length(lg);
		float ring = pl_cover(abs(lr - 6.2 - beat * 0.8) - 0.9, px);
		c = over(c, acc, exp(-abs(lr - 6.2) / 2.0) * (0.15 + 0.5 * beat));
		c = over(c, lerp(acc, acc2, 0.5 + 0.5 * sin(time * 2.0)), ring);
		c = over(c, acc2, pl_icon(p, float2(257.0, 83.0), 1.0, px) * 0.9);
	}

	/* ---- the wide visualizer strip ---- */
	BRANCH
	if (strip_on > 0.5 && p.y > 94.0) {
		c = pl_well(c, p, float2(8.0, 96.0), float2(267.0, 112.0), px, lcd, acc, neon);
		float4 vs = pl_viz(p, float2(10.0, 97.5), float2(265.0, 110.5), pl_look.y, skin, px);
		c = over(c, vs.rgb, vs.a);
	}

	c.a *= win + neon * (1.0 - win) * step(0.0, dw);
	return c;
}

float pl_height()
{
	return lerp(98.0, 116.0, step(-0.5, pl_look.y));
}

/* screen pixels per unit: the window fits the canvas with a margin */
float pl_scale()
{
	return min(res.x * 0.94 / 275.0, res.y * 0.94 / pl_height());
}

float2 pl_pos(float2 uv, float sc)
{
	float2 o = (res - float2(275.0, pl_height()) * sc) * 0.5;
	return (uv * res - o) / sc;
}

float4 player_plain(VertData v_in, float skin)
{
	float2 uv = view_uv(v_in.uv);
	float sc = pl_scale();
	return finish_paint(pl_draw(pl_pos(uv, sc), 1.0 / sc, skin), uv);
}

float4 PSPlayerSpazz(VertData v_in) : TARGET
{
	return player_plain(v_in, 0.0);
}

float4 PSPlayerClassic(VertData v_in) : TARGET
{
	return player_plain(v_in, 1.0);
}

float4 PSPlayerNeon(VertData v_in) : TARGET
{
	return player_plain(v_in, 2.0);
}

float4 PSPlayerSynthwave(VertData v_in) : TARGET
{
	return player_plain(v_in, 3.0);
}

/* CRT: the whole player on a curved phosphor screen */
float4 PSPlayerCRT(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float sc = pl_scale();
	float2 p = pl_pos(uv, sc);
	float px = 1.0 / sc;
	float2 dims = float2(275.0, pl_height());
	float2 ctr = dims * 0.5;
	float2 cc = (p - ctr) / dims;
	float r2 = dot(cc, cc);
	p = ctr + cc * (1.0 + 0.16 * r2) * dims;
	float4 c = pl_draw(p, px * 1.1, 4.0);
	float l = dot(c.rgb, float3(0.3, 0.55, 0.15));
	c.rgb = lerp(c.rgb, pl_col(0.0) * l * 1.6, 0.8);
	float scan = 0.72 + 0.28 * sin(v_in.uv.y * res.y * 3.14159265 / 1.5);
	float rl = glmod(v_in.uv.y - time * 0.25, 1.0) * 12.0 - 6.0;
	float roll = 1.0 + 0.08 * exp(-rl * rl);
	c.rgb *= scan * roll * (0.96 + 0.04 * sin(time * 47.0));
	c.rgb += pl_col(0.0) * l * 0.25;
	return finish_paint(c, uv);
}

/* ---- the glitch players ------------------------------------------- */
/* pl_glitch.x is the Glitch amount (0 = a clean player), .y how hard the */
/* music hits right now (the amount already applied), .z a clock that     */
/* ticks 14 times a second but holds still for a moment on big hits.     */

/* random glitch bursts: frequent when it's loud, rare when it's quiet */
float pl_burst(float tick, float gd)
{
	float calm = saturate(0.35 + gd * 1.5);
	return step(0.82 - 0.35 * gd, hash11(tick * 0.37 + 1.3)) * step(hash11(tick * 0.71 + 0.2), calm);
}

/* rows of the player jumping sideways */
float pl_slip(float2 p, float tick, float gd, float ga, float burst, float rowh)
{
	float row = floor(p.y / rowh);
	float g = hash21(float2(row, tick));
	float slip = (g - 0.5) * (14.0 + 22.0 * saturate(gd)) * burst * step(0.7 - 0.15 * saturate(gd), hash21(float2(row * 1.7, tick + 3.0)));
	/* big hits tear whole bands across */
	float tear = step(0.6, gd) * step(0.86, hash21(float2(floor(p.y / 14.0), tick + 9.0)));
	slip += tear * (hash21(float2(floor(p.y / 14.0), tick + 2.0)) - 0.5) * 34.0;
	return slip * ga;
}

/* Glitch: colour channels split apart and slices jump sideways, harder the
 * louder it gets; big hits tear bands, swap or invert the colours */
float4 PSPlayerGlitch(VertData v_in) : TARGET
{
	float ga = pl_glitch.x;
	BRANCH
	if (ga < 0.001) {
		return player_plain(v_in, 5.0);
	}
	float2 uv = view_uv(v_in.uv);
	float sc = pl_scale();
	float2 p = pl_pos(uv, sc);
	float px = 1.0 / sc;
	float2 dims = float2(275.0, pl_height());
	float gd = pl_glitch.y;
	float tick = pl_glitch.z;
	float burst = pl_burst(tick, gd);
	p.x += pl_slip(p, tick, gd, ga, burst, 4.5);
	/* the whole player jolts on the biggest hits */
	p.y += (hash11(tick * 1.17 + 5.0) - 0.5) * 5.0 * step(0.9, gd) * ga;
	float split = (0.6 + 1.6 * gd + 1.4 * burst) * ga;
	float4 cr = pl_draw(p + float2(split, 0.0), px, 5.0);
	float4 cg = pl_draw(p, px, 5.0);
	float4 cb = pl_draw(p - float2(split, 0.0), px, 5.0);
	float a = max(cg.a, max(cr.a, cb.a));
	float3 rgb = float3(cr.r * cr.a, cg.g * cg.a, cb.b * cb.a) / max(a, 0.0001);
	/* blocks of digital junk */
	float2 blk = floor(p / float2(9.0, 3.0));
	float jt = 0.994 - (0.012 * gd + 0.01 * burst + 0.03 * saturate(gd - 0.6)) * ga;
	float junk = step(jt, hash21(blk + tick * 1.31)) * step(0.0, p.y) * step(p.y, dims.y);
	rgb = lerp(rgb, pl_col(hash21(blk) * 0.6), junk * 0.8);
	a = max(a, junk * 0.8 * step(0.0, p.x) * step(p.x, dims.x));
	/* big hits: channels swap places, or the picture flashes inverted */
	float swap = step(0.75, gd) * step(0.55, hash11(tick * 1.91 + 4.0));
	rgb = lerp(rgb, rgb.gbr, swap);
	float inv = step(1.0, gd) * step(0.78, hash11(tick * 2.31 + 0.7));
	rgb = lerp(rgb, float3(1.0, 1.0, 1.0) - rgb, inv * 0.85);
	rgb *= 0.9 + 0.1 * step(0.5, frac(v_in.uv.y * res.y / 2.0));
	return finish_paint(float4(rgb, a), uv);
}

/* RGB Glitch: three rainbow copies of the player orbit each other, wider
 * apart the harder the music hits */
float4 PSPlayerRGBGlitch(VertData v_in) : TARGET
{
	float ga = pl_glitch.x;
	BRANCH
	if (ga < 0.001) {
		return player_plain(v_in, 0.0);
	}
	float2 uv = view_uv(v_in.uv);
	float sc = pl_scale();
	float2 p = pl_pos(uv, sc);
	float px = 1.0 / sc;
	float gd = pl_glitch.y;
	float tick = pl_glitch.z;
	float burst = pl_burst(tick, gd);
	p.x += pl_slip(p, tick, gd, ga, burst, 3.5) * 0.8;
	float ang = time * 1.7 + gd * 2.0;
	float rad = (0.9 + 2.4 * gd + 1.2 * burst) * ga;
	float2 o1 = rad * float2(cos(ang), sin(ang) * 0.6);
	float2 o2 = rad * float2(cos(ang + 2.0944), sin(ang + 2.0944) * 0.6);
	float2 o3 = rad * float2(cos(ang + 4.1888), sin(ang + 4.1888) * 0.6);
	float4 c1 = pl_draw(p + o1, px, 0.0);
	float4 c2 = pl_draw(p + o2, px, 0.0);
	float4 c3 = pl_draw(p + o3, px, 0.0);
	float hz = pl_look.z * 2.0 + time * 0.08;
	float3 h1 = pl_hsv(hz, 1.0, 1.0);
	float3 h2 = pl_hsv(hz + 0.3333, 1.0, 1.0);
	float3 h3 = pl_hsv(hz + 0.6667, 1.0, 1.0);
	float3 rgb = (c1.rgb * c1.a * h1 + c2.rgb * c2.a * h2 + c3.rgb * c3.a * h3) / max(h1 + h2 + h3, 0.0001);
	float a = max(c1.a, max(c2.a, c3.a));
	rgb = rgb / max(a, 0.0001) * (1.0 + 0.35 * gd);
	rgb *= 0.9 + 0.1 * step(0.5, frac(v_in.uv.y * res.y / 2.0));
	return finish_paint(float4(rgb, a), uv);
}

/* Datamosh: on the hits, blocks of the player smear and bleed like a video
 * whose keyframes went missing */
float4 PSPlayerDatamosh(VertData v_in) : TARGET
{
	float ga = pl_glitch.x;
	BRANCH
	if (ga < 0.001) {
		return player_plain(v_in, 0.0);
	}
	float2 uv = view_uv(v_in.uv);
	float sc = pl_scale();
	float2 p = pl_pos(uv, sc);
	float px = 1.0 / sc;
	float gd = pl_glitch.y;
	float tick = pl_glitch.z;
	float2 bs = float2(8.0, 6.0);
	float2 blk = floor(p / bs);
	float2 cell = frac(p / bs);
	float era = floor(tick / 3.0);
	float m = step(1.0 - saturate((0.025 + 0.26 * gd) * ga), hash21(blk + era * 1.7));
	float2 mv = (float2(hash21(blk + 3.1 + era), hash21(blk + 7.7 + era)) - 0.5) * float2(26.0, 8.0) * ga;
	/* a moshed block shows a stretched sliver from somewhere else */
	float2 q = lerp(p, float2(p.x + mv.x, (blk.y + 0.18 * cell.y) * bs.y + mv.y), m);
	float4 c = pl_draw(q, px, 0.0);
	/* and the colour bleeds downwards out of it */
	float4 g = pl_draw(q - float2(mv.x * 0.3, 3.0 + 7.0 * gd), px, 0.0);
	float3 rgb = lerp(c.rgb, max(c.rgb, g.rgb * 0.95), m * 0.65);
	rgb = lerp(rgb, floor(rgb * 5.0) / 5.0, m * 0.6);
	rgb = lerp(rgb, rgb.gbr, m * step(0.7, hash21(blk + 11.0 + era)));
	float a = max(c.a, g.a * m);
	/* faint macroblock edges where it moshes */
	float edge = max(step(cell.x, 0.06), step(cell.y, 0.08)) * m;
	rgb = lerp(rgb, pl_col(0.5), edge * 0.25);
	return finish_paint(float4(rgb, a), uv);
}

/* VHS Glitch: a worn tape: wobble, a tracking band, colour bleeding off
 * the edges, head-switch noise at the bottom, snow on the hits */
float4 PSPlayerVHSGlitch(VertData v_in) : TARGET
{
	float ga = pl_glitch.x;
	BRANCH
	if (ga < 0.001) {
		return player_plain(v_in, 1.0);
	}
	float2 uv = view_uv(v_in.uv);
	float sc = pl_scale();
	float2 p = pl_pos(uv, sc);
	float px = 1.0 / sc;
	float gd = pl_glitch.y;
	float tick = pl_glitch.z;
	float y = v_in.uv.y;
	p.x += (sin(p.y * 0.35 + time * 3.0) * 0.35 + sin(time * 1.3) * 0.3) * ga * (0.6 + gd);
	/* the tracking band rolls down the picture */
	float bc = frac(time * 0.11 + 0.3);
	float bw = 0.03 + 0.07 * gd;
	float band = step(abs(y - bc), bw) * ga;
	float rowh = floor(p.y / 1.2);
	p.x += band * (hash21(float2(rowh, tick)) - 0.5) * (6.0 + 22.0 * gd);
	/* head switching along the bottom */
	float head = step(0.93, y) * ga;
	p.x += head * (y - 0.93) / 0.07 * (8.0 + 10.0 * hash11(tick * 0.9));
	p.y += (hash11(tick * 1.3 + 2.0) - 0.5) * 2.5 * step(0.85, gd) * ga;
	float4 c = pl_draw(p, px, 1.0);
	float4 cc = pl_draw(p - float2((1.6 + 3.5 * gd) * ga, 0.0), px, 1.0);
	float3 lw = float3(0.299, 0.587, 0.114);
	float luma = dot(c.rgb, lw);
	float3 chroma = cc.rgb - dot(cc.rgb, lw);
	float3 rgb = luma + chroma * 1.15;
	rgb = lerp(float3(luma, luma, luma), rgb, 0.85) * float3(1.04, 1.0, 0.92);
	float a = max(c.a, cc.a * 0.85);
	float n = hash21(floor(v_in.uv * res / 2.0) + tick * 7.13);
	float snow = step(0.992 - 0.02 * gd - 0.06 * band - 0.1 * head, n) * ga;
	rgb = lerp(rgb, float3(0.9, 0.9, 0.95), snow * 0.7);
	a = max(a, snow * 0.6 * saturate(band + head));
	rgb *= 0.88 + 0.12 * step(0.5, frac(y * res.y / 2.0));
	return finish_paint(float4(rgb, a), uv);
}

/* Pixel Sort: on the loud parts, rows of the player stretch into bright
 * sorted streaks */
float4 PSPlayerPixelSort(VertData v_in) : TARGET
{
	float ga = pl_glitch.x;
	BRANCH
	if (ga < 0.001) {
		return player_plain(v_in, 3.0);
	}
	float2 uv = view_uv(v_in.uv);
	float sc = pl_scale();
	float2 p = pl_pos(uv, sc);
	float px = 1.0 / sc;
	float gd = pl_glitch.y;
	float tick = pl_glitch.z;
	float era = floor(tick / 2.0);
	float rowi = floor(p.y / 1.5);
	float on = step(1.0 - saturate((0.08 + 0.7 * gd) * ga), hash21(float2(rowi, era)));
	float x0 = hash21(float2(rowi * 2.3, era + 1.0)) * 275.0 - 20.0;
	float len = (20.0 + 140.0 * hash21(float2(rowi * 0.7, era + 2.0))) * (0.4 + gd) * min(ga, 1.5);
	float inrun = on * step(x0, p.x) * step(p.x, x0 + len);
	float t = saturate((p.x - x0) / max(len, 1.0));
	float2 q = float2(lerp(p.x, x0 + len * t * t * t, inrun), p.y);
	float4 c = pl_draw(q, px, 3.0);
	float3 rgb = lerp(c.rgb, c.rgb * (0.5 + 1.0 * t) + pl_col(t * 0.3) * 0.2 * t, inrun);
	/* the odd vertical drip too */
	float coli = floor(p.x / 2.0);
	float drip = step(1.0 - saturate(0.12 * gd * ga), hash21(float2(coli, era + 5.0)));
	float y0 = hash21(float2(coli * 1.9, era + 6.0)) * pl_height();
	float dl = (8.0 + 30.0 * gd) * hash21(float2(coli, era + 8.0));
	float indrip = drip * step(y0, p.y) * step(p.y, y0 + dl) * (1.0 - inrun);
	float4 d = pl_draw(float2(p.x, y0), px, 3.0);
	rgb = lerp(rgb, d.rgb * (1.2 - 0.6 * (p.y - y0) / max(dl, 1.0)), indrip * d.a);
	float a = max(c.a, indrip * d.a);
	return finish_paint(float4(rgb, a), uv);
}

/* Neon Glitch: the neon player tears, flickers like a dying sign and throws
 * a ghost copy on the hits */
float4 PSPlayerNeonGlitch(VertData v_in) : TARGET
{
	float ga = pl_glitch.x;
	BRANCH
	if (ga < 0.001) {
		return player_plain(v_in, 2.0);
	}
	float2 uv = view_uv(v_in.uv);
	float sc = pl_scale();
	float2 p = pl_pos(uv, sc);
	float px = 1.0 / sc;
	float gd = pl_glitch.y;
	float tick = pl_glitch.z;
	float burst = pl_burst(tick, gd);
	p.x += pl_slip(p, tick, gd, ga, burst, 6.0);
	float4 c1 = pl_draw(p, px, 2.0);
	float2 go = float2((1.5 + 3.5 * gd) * ga, -0.8 * gd * ga);
	float4 c2 = pl_draw(p + go, px, 2.0);
	float dip = step(0.72 - 0.3 * gd, hash11(tick * 1.3 + 2.0)) * (0.45 + 0.4 * saturate(gd)) * min(ga, 1.0);
	float f = 1.0 - dip;
	float3 rgb = c1.rgb * c1.a * f + c2.rgb * c2.a * pl_col(0.5) * 0.55 * min(ga, 1.0);
	float a = max(c1.a * f, c2.a * 0.55 * min(ga, 1.0));
	/* sparks: a bright line flicks across on the big hits */
	float ly = hash11(tick * 0.77 + 3.0) * pl_height();
	float spark = exp(-abs(p.y - ly) * 2.5) * step(0.7, gd) * step(0.5, hash11(tick * 0.31 + 1.0)) * ga;
	spark *= step(0.0, p.x) * step(p.x, 275.0);
	rgb += pl_col(0.2) * spark;
	a = max(a, spark * 0.8);
	rgb = rgb / max(a, 0.0001);
	return finish_paint(float4(rgb, a), uv);
}

/* Corrupted: wrong colours in blocks, letters turning to garbage, broken
 * pieces knocked out of place, more of it the harder it hits */
float4 PSPlayerCorrupted(VertData v_in) : TARGET
{
	float ga = pl_glitch.x;
	BRANCH
	if (ga < 0.001) {
		return player_plain(v_in, 1.0);
	}
	float2 uv = view_uv(v_in.uv);
	float sc = pl_scale();
	float2 p = pl_pos(uv, sc);
	float px = 1.0 / sc;
	float gd = pl_glitch.y;
	float tick = pl_glitch.z;
	float era = floor(tick / 4.0);
	float2 blk = floor(p / float2(22.0, 10.0));
	float hit = step(1.0 - saturate((0.06 + 0.4 * gd) * ga), hash21(blk + era * 3.1));
	p += hit * (float2(hash21(blk + 5.0 + era), hash21(blk + 6.0 + era)) - 0.5) * float2(18.0, 4.0) * ga;
	float4 c = pl_draw(p, px, 1.0);
	float k = floor(hash21(blk + 9.0 + era) * 5.0);
	float3 w = k < 1.0 ? c.brg : (k < 2.0 ? c.gbr : (k < 3.0 ? float3(1.0, 1.0, 1.0) - c.rgb : (k < 4.0 ? c.rrb : c.bgg)));
	float3 rgb = lerp(c.rgb, w, hit);
	/* stuck pixels and dead blocks */
	float2 fine = floor(p / float2(3.0, 2.0));
	float dead = step(0.996 - 0.02 * gd * ga, hash21(fine + era * 1.3)) * step(0.0, p.y) * step(p.y, pl_height());
	rgb = lerp(rgb, pl_col(hash21(fine) * 0.7), dead);
	float a = max(c.a, dead * step(0.0, p.x) * step(p.x, 275.0));
	rgb *= 0.92 + 0.08 * step(0.5, frac(v_in.uv.y * res.y / 2.0));
	return finish_paint(float4(rgb, a), uv);
}

/* Vaporwave Glitch: the synthwave player splits into pink and cyan, waving
 * gently and pulling apart on the bass */
float4 PSPlayerVaporGlitch(VertData v_in) : TARGET
{
	float ga = pl_glitch.x;
	BRANCH
	if (ga < 0.001) {
		return player_plain(v_in, 3.0);
	}
	float2 uv = view_uv(v_in.uv);
	float sc = pl_scale();
	float2 p = pl_pos(uv, sc);
	float px = 1.0 / sc;
	float gd = pl_glitch.y;
	float tick = pl_glitch.z;
	float burst = pl_burst(tick, gd);
	p.x += sin(p.y * 0.18 + time * 1.6) * 0.8 * ga * (0.4 + gd);
	p.x += pl_slip(p, tick, gd, ga, burst, 5.0) * 0.6;
	float s = (1.2 + 2.6 * gd) * ga;
	float4 c1 = pl_draw(p + float2(s, s * 0.25), px, 3.0);
	float4 c2 = pl_draw(p - float2(s, s * 0.25), px, 3.0);
	float3 ca = pl_look.w < 0.5 ? float3(1.0, 0.44, 0.81) : pl_col(0.0);
	float3 cb = pl_look.w < 0.5 ? float3(0.0, 0.8, 1.0) : pl_col(0.33);
	float l1 = dot(c1.rgb, float3(0.333, 0.333, 0.333)) * c1.a;
	float l2 = dot(c2.rgb, float3(0.333, 0.333, 0.333)) * c2.a;
	float a = max(c1.a, c2.a);
	float3 base = (c1.rgb * c1.a + c2.rgb * c2.a) * 0.5;
	float3 rgb = lerp(base, ca * l1 * 1.5 + cb * l2 * 1.5, 0.6) / max(a, 0.0001);
	rgb *= 0.9 + 0.1 * step(0.5, frac(v_in.uv.y * res.y / 3.0));
	return finish_paint(float4(rgb, a), uv);
}

/* Hologram Glitch: a flickering see-through hologram of the player, with
 * scanlines, a rolling bright band and jumps on the hits */
float4 PSPlayerHoloGlitch(VertData v_in) : TARGET
{
	float ga = pl_glitch.x;
	BRANCH
	if (ga < 0.001) {
		return player_plain(v_in, 0.0);
	}
	float2 uv = view_uv(v_in.uv);
	float sc = pl_scale();
	float2 p = pl_pos(uv, sc);
	float px = 1.0 / sc;
	float gd = pl_glitch.y;
	float tick = pl_glitch.z;
	float burst = pl_burst(tick, gd);
	p.x += pl_slip(p, tick, gd, ga, burst, 3.0) * 0.7;
	p.y += (hash11(tick * 0.93) - 0.5) * 3.0 * step(0.6, gd) * step(0.5, hash11(tick * 0.61 + 2.0)) * ga;
	float4 c = pl_draw(p, px, 0.0);
	float4 c2 = pl_draw(p + float2((0.8 + 1.8 * gd) * ga, 0.0), px, 0.0);
	float3 hc = pl_look.w < 0.5 ? float3(0.3, 0.95, 1.0) : pl_col(0.0);
	float l = dot(c.rgb, float3(0.3, 0.55, 0.15));
	float3 rgb = hc * (l * 2.4 + 0.14);
	rgb += pl_col(0.5) * dot(c2.rgb, float3(0.3, 0.55, 0.15)) * c2.a * 0.35;
	float scan = 0.72 + 0.28 * sin(v_in.uv.y * res.y * 3.14159265 / 2.0 + time * 18.0);
	float rb = glmod(v_in.uv.y - time * 0.35, 1.0) * 10.0 - 5.0;
	float roll = 1.0 + 0.35 * exp(-rb * rb);
	float flick = 0.86 + 0.14 * hash11(floor(time * 24.0)) - 0.35 * step(0.75 - 0.25 * gd, hash11(tick * 1.7 + 0.4)) * min(ga, 1.0);
	rgb *= scan * roll * flick;
	float a = max(c.a, c2.a * 0.5) * (0.7 + 0.25 * flick);
	return finish_paint(float4(rgb, a), uv);
}

/* ------------------------------------------------------------------ */
/* Neon scope: a vector oscilloscope, beam glow and afterglow, with a  */
/* Lissajous figure kicking with the bass                              */

float ns_wave(float x, float t)
{
	float a = 0.0;
	for (int k = 1; k <= 8; k++) {
		float kf = float(k);
		float e = band_level(kf / 9.0);
		a += e * sin(x * 6.2831853 * (kf * 1.2 + 0.5) + t * (1.5 + kf * 1.3) + kf * 2.1) / sqrt(kf);
	}
	return a;
}

float4 PSNeonScope(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float px = 1.0 / res.y;
	float2 p = float2(uv.x * aspect, uv.y);
	float3 light = float3(0.0, 0.0, 0.0);

	/* graticule */
	float2 gq = abs(frac(float2((p.x - aspect * 0.5) * 8.0, (p.y - 0.5) * 8.0) + 0.5) - 0.5) / 8.0;
	float grid = (1.0 - smoothstep(0.0, px * 1.2, gq.x)) + (1.0 - smoothstep(0.0, px * 1.2, gq.y));
	light += prism(hue + 0.5) * grid * 0.035;

	/* the trace, with two fading echoes behind it */
	float amp = 0.17 * (0.6 + 0.8 * level) * density;
	for (int e = 0; e < 3; e++) {
		float ef = float(e);
		float t = time - ef * 0.06;
		float y = 0.5 - ns_wave(p.x / aspect, t) * amp;
		float d = abs(p.y - y);
		float k = exp(-ef * 1.1);
		float3 tc = prism(hue + p.x / aspect * 0.35 + ef * 0.05);
		light += tc * (exp(-d / (px * 2.0)) * 1.6 + exp(-d / 0.02) * 0.35) * k;
	}

	/* Lissajous: x and y from different bands */
	float2 ctr = float2(aspect * 0.5, 0.5);
	float rad = 0.16 + 0.08 * bass + 0.05 * beat;
	float best = 1.0;
	BRANCH
	if (length(p - ctr) < rad * 1.5 + 0.1) {
		float fa = 2.0 + floor(mid * 3.0);
		float2 a0 = ctr + rad * float2(sin(time * 0.7), sin(time * 0.5));
		for (int i = 1; i <= 48; i++) {
			float s = float(i) / 48.0 * 6.2831853;
			float2 a1 = ctr + rad * float2(sin(s * fa + time * 0.7), sin(s * 3.0 + time * 0.5));
			best = min(best, pl_seg(p, a0, a1));
			a0 = a1;
		}
	}
	float3 lc = prism(hue + 0.3);
	light += lc * (exp(-best / (px * 2.2)) * 1.3 + exp(-best / 0.025) * (0.25 + 0.5 * beat));
	return finish(light, uv);
}

/* ------------------------------------------------------------------ */
/* CRT spectrum: bars on a curved old TV, scanlines, an aperture grille */
/* and the picture rolling                                              */

float4 PSCRTSpectrum(VertData v_in) : TARGET
{
	float2 uv0 = view_uv(v_in.uv);
	float2 cc = uv0 - 0.5;
	float r2 = dot(cc, cc);
	float2 uv = 0.5 + cc * (1.0 + 0.22 * r2);
	float edge = smoothstep(0.0, 0.012, uv.x) * smoothstep(0.0, 0.012, uv.y) * smoothstep(0.0, 0.012, 1.0 - uv.x) *
		     smoothstep(0.0, 0.012, 1.0 - uv.y);
	float aspect = res.x / res.y;
	float3 light = float3(0.0, 0.0, 0.0);

	float n = floor(clamp(28.0 * density, 8.0, 64.0));
	float i = floor(uv.x * n);
	float fx = frac(uv.x * n);
	float4 bd = band_full((i + 0.5) / n);
	float yup = 1.0 - uv.y;
	float top = 0.06 + 0.86 * bd.r;
	float bar = smoothstep(0.08, 0.16, fx) * smoothstep(0.92, 0.84, fx);
	float inside = bar * step(yup, top) * step(0.04, yup);
	float3 bc = prism(hue + i / n * 0.6 + yup * 0.15);
	light += bc * inside * (0.8 + 0.6 * yup) * (1.0 + 0.6 * bd.b);
	/* bloom above each bar and a peak line */
	light += bc * bar * exp(-max(yup - top, 0.0) / 0.03) * step(top, yup) * 0.5;
	float pk = 0.06 + 0.86 * bd.g;
	light += lerp(bc, float3(1.0, 1.0, 1.0), 0.5) * bar * exp(-abs(yup - pk) * res.y / 1.8) * 1.2;
	/* glow behind everything */
	light += bc * 0.12 * exp(-abs(yup - top * 0.5) * 3.0) * level;

	/* scanlines, an aperture grille, the picture rolling, vignette */
	float scan = 0.65 + 0.35 * sin(uv.y * res.y * 3.14159265 / 1.5);
	float grille = 0.78 + 0.22 * sin(v_in.uv.x * res.x * 3.14159265 * 0.66);
	float rl = glmod(uv.y - time * 0.18, 1.0) * 10.0 - 5.0;
	float roll = 1.0 + 0.12 * exp(-rl * rl);
	float vig = 1.0 - r2 * 1.6;
	light *= scan * grille * roll * vig * (0.97 + 0.03 * sin(time * 53.0)) * edge;
	light += prism(hue) * 0.03 * edge * vig;
	return finish(light, uv0);
}

/* ------------------------------------------------------------------ */
/* Glitch bars: a spectrum that tears, splits into RGB and drops junk  */
/* blocks on the beat                                                  */

float gb_bars(float2 uv, float n)
{
	float i = floor(uv.x * n);
	float fx = frac(uv.x * n);
	float e = band_level((i + 0.5) / n);
	float yup = 1.0 - uv.y;
	return step(0.12, fx) * step(fx, 0.88) * step(yup, 0.05 + 0.85 * e) * step(0.05, yup);
}

float4 PSGlitchBars(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float tick = floor(time * 12.0);
	float row = floor(uv.y * 40.0);
	float burst = step(0.78 - 0.4 * beat, hash11(tick * 0.71 + 0.3));
	float shift = (hash21(float2(row, tick)) - 0.5) * 0.08 * burst * step(0.5, hash21(float2(row + 5.0, tick)));
	float2 q = float2(uv.x + shift, uv.y);
	float n = floor(clamp(24.0 * density, 8.0, 64.0));
	float sp = (0.003 + 0.012 * beat + 0.01 * burst);
	float r = gb_bars(q + float2(sp, 0.0), n);
	float g = gb_bars(q, n);
	float b = gb_bars(q - float2(sp, 0.0), n);
	float3 tint = prism(hue + floor(q.x * n) / n * 0.5);
	float3 light = float3(r, g, b) * lerp(float3(1.0, 1.0, 1.0), tint * 1.3, 0.8) * 1.2;
	/* junk blocks and a stuck colour band */
	float2 blk = floor(uv * float2(28.0, 18.0));
	float junk = step(0.975 - 0.05 * beat, hash21(blk + tick * 1.7));
	light += prism(hash21(blk) + hue) * junk * 0.9;
	float band = step(abs(uv.y - hash11(tick * 0.13)), 0.012) * burst;
	light += prism(hue + 0.5) * band * 0.8;
	light *= 0.85 + 0.15 * step(0.5, frac(v_in.uv.y * res.y / 2.0));
	return finish(light, uv);
}

/* ------------------------------------------------------------------ */
/* VHS tape: a wobbly, colour-bleeding playback with a tracking band,  */
/* "PLAY" and the song's time on the screen                            */

float4 PSVHSTape(VertData v_in) : TARGET
{
	float2 uv = view_uv(v_in.uv);
	float aspect = res.x / res.y;
	float t = time;
	/* tape wobble and the tracking band rolling down */
	float wob = sin(uv.y * 40.0 + t * 3.0) * 0.0015 + sin(uv.y * 7.0 - t * 1.3) * 0.002;
	float trk_y = glmod(t * 0.11, 1.4) - 0.2;
	float tdy = (uv.y - trk_y) * 28.0;
	float trk = exp(-tdy * tdy);
	wob += trk * (hash21(float2(floor(uv.y * 160.0), floor(t * 30.0))) - 0.5) * 0.04;
	float2 q = float2(uv.x + wob, uv.y);
	float2 p = float2(q.x * aspect, q.y);
	float3 light = float3(0.0, 0.0, 0.0);

	/* the picture: soft spectrum hills, colour bleeding to the right */
	for (int k = 0; k < 3; k++) {
		float kf = float(k);
		float x = q.x - kf * 0.006;
		float e = band_level(abs(x - 0.5) * 2.0);
		float hill = 0.82 - e * 0.55 - 0.05 * sin(x * 20.0 + t);
		float m = smoothstep(hill, hill + 0.02, q.y) * smoothstep(0.98, 0.9, q.y);
		float3 cc = prism(hue + x * 0.4 + q.y * 0.2);
		light += (kf < 0.5 ? cc : (kf < 1.5 ? float3(cc.r, 0.0, 0.0) * 0.6 : float3(0.0, 0.0, cc.b) * 0.6)) * m * 0.8;
		light += cc * exp(-abs(q.y - hill) * res.y / 3.0) * 0.6 * (kf < 0.5 ? 1.0 : 0.0);
	}
	/* sun-ish glow behind */
	float2 sd = p - float2(aspect * 0.5, 0.45);
	light += prism(hue + 0.1) * exp(-length(sd) / 0.12) * (0.25 + 0.6 * bass);

	/* snow and the tracking band */
	float snow = hash21(floor(v_in.uv * res / 2.0) + floor(t * 24.0) * 7.0);
	light += float3(1.0, 1.0, 1.0) * step(0.985, snow) * 0.35;
	light += float3(0.9, 0.9, 1.0) * trk * step(0.6, snow) * 0.5;

	/* on-screen display: "PLAY >" and the time, in the pixel font */
	float fp = max(floor(res.y / 110.0), 1.0) / res.y;
	float2 tp = float2(uv.x * aspect, uv.y);
	float osd = pl_text(tp, float2(0.05, 0.06), fp, 1.0 / res.y, 3.0, 47.0, 4.0, 0.0, 0.0);
	float2 ic = (tp - float2(0.05 + fp * 27.0, 0.06 + fp * 3.5)) / (fp);
	float tri = step(-2.5, ic.x) * step(abs(ic.y), (2.5 - ic.x) * 0.6) * step(ic.x, 2.5);
	float blink = step(0.35, frac(t * 0.8));
	light += float3(1.0, 1.0, 1.0) * (osd + tri * blink) * 1.2;
	/* SP m:ss from the music player's clock: digit glyphs are codes 16..25 */
	float2 tq = (tp - float2(0.05, 0.86)) / (fp);
	float cell = floor(tq.x / 6.0);
	float code = cell < 0.5 ? 51.0 : (cell < 1.5 ? 48.0 : (cell < 2.5 ? 0.0 : (cell < 3.5 ? 16.0 + pl_digits.x :
		     (cell < 4.5 ? 16.0 + pl_digits.y : (cell < 5.5 ? 26.0 : (cell < 6.5 ? 16.0 + pl_digits.z : 16.0 + pl_digits.w))))));
	float inside = step(0.0, tq.x) * step(tq.x, 8.0 * 6.0) * step(0.0, tq.y) * step(tq.y, 7.99);
	light += float3(1.0, 1.0, 1.0) * pl_glyph(code, float2(tq.x - cell * 6.0, tq.y)) * inside * 1.1;

	light *= 0.88 + 0.12 * step(0.5, frac(v_in.uv.y * res.y / 2.0));
	return finish(light, uv);
}

technique PrismRain
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSPrismRain(v_in);
	}
